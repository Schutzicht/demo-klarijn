---
// Strategiesessie: minimalistische tool waar het board domineert.
// State alleen in URL hash wanneer expliciet gedeeld.
import '../styles/global.css';

const seed = {
  v: 7,
  meta: { titel: 'Strategiesessie Klarijn' },
  boards: [
    {
      id: 'doelstellingen',
      label: 'Doelstellingen',
      vraag: 'Wat moet de website concreet bereiken?',
      notes: [
        { text: 'Direct contact', c: 0 },
        { text: 'Vindbaarheid juridische vragen', c: 2 },
        { text: 'Onderscheid van advocaten', c: 1 },
        { text: 'Klant en franchise gescheiden', c: 3 },
        { text: 'Beheer door eigen team', c: 4 },
        { text: 'Productcatalogus tonen', c: 2 },
        { text: 'Abonnement hoofdpropositie', c: 0 },
        { text: 'Mobiel-eerste presentatie', c: 1 },
        { text: 'AVG-proof, geen tracking', c: 3 },
        { text: 'Match-test franchise', c: 4 },
        { text: 'Live in Q3', c: 2 },
        { text: 'Snelle laadtijd', c: 0 },
      ],
    },
    {
      id: 'doelgroepen',
      label: 'Doelgroepen',
      vraag: 'Wie willen we bereiken?',
      notes: [
        { text: 'MKB met geschil', c: 3 },
        { text: 'Familiebedrijf in overdracht', c: 1 },
        { text: 'Cateraar of horeca', c: 4 },
        { text: 'Webshop met IE-vraag', c: 2 },
        { text: 'Jurist overweegt franchise', c: 0 },
        { text: 'Aannemer arbeidsconflict', c: 1 },
        { text: 'Loonwerker', c: 3 },
        { text: 'Mkb-directeur', c: 2 },
        { text: 'Bedrijfsjurist', c: 4 },
        { text: 'Detailhandel huur-issue', c: 0 },
        { text: 'Schoonheidsspecialist', c: 1 },
        { text: 'Advocaat overstap', c: 3 },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Strategiesessie Klarijn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --ag-indigo: #2d3fe0;
        --ag-indigo-hover: #1f2bb8;
        --ag-indigo-sky: #eef0fe;
        --ink: #0f0f12;
        --ink-soft: #56575c;
        --ink-muted: #8b8c93;
        --paper: #fafaf7;
        --board-bg: #ffffff;
        --border: rgba(15,15,18,0.08);
        --border-soft: rgba(15,15,18,0.05);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        background: var(--paper);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        margin: 0;
      }

      /* === Top bar === */
      .topbar {
        background: rgba(250,250,247,0.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .topbar-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 24px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Outfit', sans-serif;
      }
      .brand-text {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .brand-sep {
        color: var(--ink-muted);
        font-size: 12px;
        margin: 0 2px;
      }
      .brand-client {
        font-size: 14px;
        font-weight: 500;
        color: var(--ink-soft);
      }
      .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .btn {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 12px;
        border-radius: 8px;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        cursor: pointer;
        border: none;
        background: transparent;
      }
      .btn-ghost { color: var(--ink-soft); }
      .btn-ghost:hover { background: rgba(15,15,18,0.04); color: var(--ink); }
      .btn-primary { background: var(--ink); color: white; font-weight: 600; padding: 7px 14px; }
      .btn-primary:hover { background: #1f2024; }

      /* === Sub-header met tabs === */
      .subhead {
        max-width: 1320px;
        margin: 0 auto;
        padding: 28px 24px 0;
      }
      .session-title {
        font-family: 'Outfit', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-muted);
        letter-spacing: 0.01em;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .tab-bar {
        display: flex;
        gap: 32px;
        border-bottom: 1px solid var(--border);
      }
      .tab {
        font-family: 'Outfit', sans-serif;
        font-size: 16px;
        font-weight: 500;
        color: var(--ink-soft);
        background: transparent;
        cursor: pointer;
        padding: 12px 0 14px;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color 0.15s, border-color 0.15s;
        display: inline-flex;
        align-items: center;
      }
      .tab:hover { color: var(--ink); }
      .tab[aria-selected="true"] {
        color: var(--ink);
        border-bottom-color: var(--ink);
        font-weight: 600;
      }
      .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 10px;
        min-width: 20px;
        height: 18px;
        padding: 0 6px;
        border-radius: 999px;
        background: rgba(15,15,18,0.06);
        color: var(--ink-muted);
        font-size: 11px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
      }
      .tab[aria-selected="true"] .tab-count {
        background: var(--ink);
        color: white;
      }

      /* === Board === */
      .canvas-wrap {
        max-width: 1320px;
        margin: 0 auto;
        padding: 24px 24px 48px;
      }
      .board-context {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
        flex-wrap: wrap;
      }
      .board-question {
        font-family: 'Outfit', sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
        line-height: 1.2;
        margin: 0;
      }
      .board-hint {
        font-size: 13px;
        color: var(--ink-muted);
      }
      .board {
        background: var(--board-bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 28px;
        min-height: 540px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(15,15,18,0.04);
      }
      .postit-wall {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: flex-start;
      }

      /* === Post-its === */
      .pi-0 { background: #FEEB8E; }
      .pi-1 { background: #FFB9C8; }
      .pi-2 { background: #B5E3C3; }
      .pi-3 { background: #BCD3F2; }
      .pi-4 { background: #FFC9A6; }

      .postit {
        position: relative;
        width: 112px;
        height: 112px;
        padding: 13px;
        box-shadow:
          0 1px 1px rgba(15,15,18,0.05),
          0 5px 10px -2px rgba(15,15,18,0.12),
          0 12px 22px -8px rgba(15,15,18,0.12);
        font-family: 'Caveat', cursive;
        font-size: 17px;
        line-height: 1.15;
        color: #1a1a1d;
        word-break: break-word;
        transition: transform 0.16s ease, box-shadow 0.16s ease, z-index 0s 0.16s;
        cursor: text;
        display: flex;
        align-items: flex-start;
        border-radius: 2px;
      }
      .postit:focus-within, .postit:hover {
        box-shadow:
          0 2px 4px rgba(15,15,18,0.08),
          0 14px 28px -6px rgba(15,15,18,0.24);
        transform: scale(1.06) rotate(0deg) !important;
        z-index: 10;
        transition: transform 0.16s ease, box-shadow 0.16s ease, z-index 0s 0s;
      }
      .postit-text {
        outline: none;
        flex: 1;
        min-height: 100%;
        width: 100%;
      }
      .postit-text:empty::before {
        content: attr(data-placeholder);
        color: rgba(15,15,18,0.3);
        font-style: italic;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
      }
      .postit .x {
        position: absolute;
        top: 4px;
        right: 4px;
        opacity: 0;
        transition: opacity 0.15s;
        font-size: 12px;
        background: rgba(255,255,255,0.92);
        border-radius: 999px;
        width: 18px;
        height: 18px;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        color: var(--ink-soft);
        line-height: 1;
        z-index: 2;
        border: 1px solid rgba(15,15,18,0.08);
      }
      .postit:hover .x, .postit:focus-within .x { opacity: 1; }
      .postit .x:hover { background: white; color: #c81e6b; }

      .add-postit {
        width: 112px;
        height: 112px;
        border: 1.5px dashed rgba(15,15,18,0.18);
        border-radius: 4px;
        display: grid;
        place-items: center;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        color: var(--ink-muted);
        cursor: pointer;
        background: rgba(15,15,18,0.015);
        transition: all 0.15s;
        align-self: flex-start;
      }
      .add-postit:hover {
        background: white;
        border-color: var(--ag-indigo);
        color: var(--ag-indigo);
      }

      /* === Footer === */
      .footer {
        max-width: 1320px;
        margin: 0 auto;
        padding: 20px 24px 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        border-top: 1px solid var(--border);
      }
      .footer-text {
        font-size: 12px;
        color: var(--ink-muted);
      }

      /* === Modal === */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(15,15,18,0.4);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }
      .modal-backdrop[data-open] { display: flex; }
      .modal {
        background: white;
        border-radius: 14px;
        padding: 28px;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(15,15,18,0.25);
        border: 1px solid var(--border);
      }
      .modal h3 {
        font-family: 'Outfit', sans-serif;
        font-size: 18px;
        font-weight: 600;
        color: var(--ink);
        margin: 0 0 6px;
      }
      .modal p {
        font-size: 13px;
        color: var(--ink-soft);
        line-height: 1.5;
        margin: 0 0 16px;
      }
      .modal-input {
        flex: 1;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 12px;
        font-family: 'Menlo', monospace;
        color: var(--ink-soft);
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .modal-input:focus { outline: none; border-color: var(--ag-indigo); }
      .modal-close {
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-soft);
        background: transparent;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: center;
        padding: 12px 0 0;
        border-top: 1px solid var(--border);
        margin-top: 12px;
      }
      .modal-close:hover { color: var(--ink); }

      .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--ink);
        color: white;
        font-size: 13px;
        padding: 8px 16px;
        border-radius: 999px;
        box-shadow: 0 8px 24px rgba(15,15,18,0.3);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s;
        z-index: 60;
      }

      @media print {
        .no-print { display: none !important; }
        .add-postit { display: none !important; }
        .postit { box-shadow: none; border: 1px solid #ccc; transform: none !important; }
        body { background: white; }
        .board { background: white; border: 1px solid #ddd; }
        .print-block { break-inside: avoid; page-break-before: always; }
        .print-block:first-child { page-break-before: auto; }
      }
    </style>
  </head>
  <body>
    <header class="topbar no-print">
      <div class="topbar-inner">
        <div class="brand">
          <img src="/agensea-logo.png" alt="" width="20" height="20" style="border-radius: 4px" />
          <span class="brand-text">Agensea</span>
          <span class="brand-sep">/</span>
          <span class="brand-client">Klarijn</span>
        </div>
        <div class="toolbar-actions">
          <button type="button" data-action="reset" class="btn btn-ghost">Reset</button>
          <button type="button" data-action="share" class="btn btn-ghost">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Deel sessie
          </button>
          <button type="button" data-action="print" class="btn btn-primary">Export PDF</button>
        </div>
      </div>
    </header>

    <section class="subhead no-print">
      <div class="session-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/></svg>
        Strategiesessie Klarijn website
      </div>
      <div class="tab-bar" role="tablist" id="tabs"></div>
    </section>

    <div class="toast" id="toast"></div>

    <main class="canvas-wrap" id="boards"></main>

    <footer class="footer no-print">
      <span class="footer-text">Automatisch opgeslagen in deze browser.</span>
      <div style="display:flex; align-items:center; gap:6px; font-size:12px; color: var(--ink-muted);">
        <img src="/agensea-logo.png" alt="" width="14" height="14" style="border-radius: 3px" />
        <span>Agensea sessietool</span>
      </div>
    </footer>

    <div class="modal-backdrop no-print" id="share-modal">
      <div class="modal">
        <h3>Sessie delen</h3>
        <p>Deze link bevat alle huidige post-its. Stuur naar de klant of collega, zij zien bij openen exact wat hier staat en kunnen zelf bijplakken.</p>
        <div style="display:flex; gap:8px; margin-bottom:12px">
          <input id="share-url" class="modal-input" type="text" readonly />
          <button id="share-copy" type="button" class="btn btn-primary">Kopieer</button>
        </div>
        <p style="margin-bottom:0">Wijzigingen aan hun kant zijn pas zichtbaar wanneer zij hun bijgewerkte link terugsturen.</p>
        <button type="button" data-close-modal class="modal-close">Sluiten</button>
      </div>
    </div>

    <script type="application/json" id="seed" set:html={JSON.stringify(seed)}></script>

    <script>
      const seedEl = document.getElementById('seed');
      const SEED = JSON.parse(seedEl.textContent);
      const clone = (o) => JSON.parse(JSON.stringify(o));

      const LS_KEY = 'klarijn_strategie_v7';
      const SEED_V = SEED.v;
      let state;
      let activeTab = 0;

      function decodeFromHash() {
        const m = location.hash.match(/^#s=(.+)$/);
        if (!m) return null;
        try {
          const json = decodeURIComponent(escape(atob(decodeURIComponent(m[1]))));
          return JSON.parse(json);
        } catch { return null; }
      }
      function encodeToHash(s) {
        try {
          const json = JSON.stringify(s);
          const b64 = btoa(unescape(encodeURIComponent(json)));
          history.replaceState(null, '', '#s=' + encodeURIComponent(b64));
        } catch {}
      }
      function clearHash() {
        if (location.hash) {
          history.replaceState(null, '', location.pathname + location.search);
        }
      }

      const fromHash = decodeFromHash();
      if (fromHash && fromHash.boards && fromHash.v === SEED_V) {
        state = fromHash;
        clearHash(); // schoonmaken zodra geladen, URL blijft kort
      } else {
        if (fromHash) clearHash(); // oude versie of corrupt, weg ermee
        try {
          const stored = localStorage.getItem(LS_KEY);
          const parsed = stored ? JSON.parse(stored) : null;
          state = (parsed && parsed.v === SEED_V) ? parsed : clone(SEED);
        } catch {
          state = clone(SEED);
        }
      }
      if (!state.boards) state.boards = clone(SEED.boards);
      state.v = SEED_V;

      let saveTimer = null;
      function save() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch {}
          // NIET meer auto-encoderen naar URL. Pas bij Delen-klik.
        }, 200);
      }

      const tabsEl = document.getElementById('tabs');
      const boardsEl = document.getElementById('boards');

      function rndRotation() {
        return (Math.random() * 8 - 4).toFixed(2);
      }

      function makePostit(board, idx) {
        const note = board.notes[idx];
        const el = document.createElement('div');
        el.className = `postit pi-${note.c ?? 0}`;
        el.style.setProperty('--rot', (note.rot ?? rndRotation()) + 'deg');
        el.style.transform = `rotate(var(--rot))`;
        el.innerHTML = `
          <button class="x" type="button" title="Verwijder" tabindex="-1">×</button>
          <div class="postit-text" contenteditable="true" data-placeholder="schrijf...">${escapeHtml(note.text || '')}</div>
        `;
        const text = el.querySelector('.postit-text');
        text.addEventListener('input', () => { note.text = text.textContent; save(); });
        text.addEventListener('blur', () => {
          if (!note.text || !note.text.trim()) {
            const i = board.notes.indexOf(note);
            if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
          }
        });
        el.querySelector('.x').addEventListener('click', (e) => {
          e.stopPropagation();
          const i = board.notes.indexOf(note);
          if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
        });
        return el;
      }

      function makeAddBtn(board) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'add-postit';
        btn.innerHTML = `<span>+ post-it</span>`;
        btn.addEventListener('click', () => {
          const c = Math.floor(Math.random() * 5);
          board.notes.push({ text: '', c, rot: rndRotation() });
          save();
          renderAll();
          setTimeout(() => {
            const allNotes = document.querySelectorAll(`[data-board="${board.id}"] .postit-text`);
            const last = allNotes[allNotes.length - 1];
            last?.focus();
          }, 30);
        });
        return btn;
      }

      function makeBoard(board, isPrint = false) {
        const section = document.createElement('section');
        section.className = 'print-block';
        section.dataset.board = board.id;
        section.innerHTML = `
          <div class="board-context">
            <h2 class="board-question">${escapeHtml(board.vraag)}</h2>
            <span class="board-hint">${board.notes.length} ${board.notes.length === 1 ? 'post-it' : 'post-its'}</span>
          </div>
          <div class="board">
            <div class="postit-wall"></div>
          </div>
        `;
        const wall = section.querySelector('.postit-wall');
        board.notes.forEach((_, idx) => {
          wall.appendChild(makePostit(board, idx));
        });
        wall.appendChild(makeAddBtn(board));
        return section;
      }

      function renderTabs() {
        tabsEl.innerHTML = '';
        state.boards.forEach((b, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.role = 'tab';
          btn.className = 'tab';
          btn.setAttribute('aria-selected', i === activeTab ? 'true' : 'false');
          btn.innerHTML = `<span>${escapeHtml(b.label)}</span><span class="tab-count">${b.notes.length}</span>`;
          btn.addEventListener('click', () => {
            activeTab = i;
            renderAll();
          });
          tabsEl.appendChild(btn);
        });
      }

      function renderBoards() {
        boardsEl.innerHTML = '';
        const active = state.boards[activeTab];
        if (active) boardsEl.appendChild(makeBoard(active));
        state.boards.forEach((b, i) => {
          if (i === activeTab) return;
          const section = makeBoard(b, true);
          section.style.display = 'none';
          section.classList.add('print-only');
          section.style.marginTop = '32px';
          boardsEl.appendChild(section);
        });
        // print: laat alle prints zien
        const style = document.createElement('style');
        style.textContent = '@media print { .print-only { display: block !important; } }';
        boardsEl.appendChild(style);
      }

      function renderAll() {
        renderTabs();
        renderBoards();
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.opacity = '1';
        setTimeout(() => { t.style.opacity = '0'; }, 1800);
      }

      document.querySelector('[data-action="reset"]').addEventListener('click', () => {
        if (!confirm('Alle post-its weg en terug naar de pre-fill?')) return;
        state = clone(SEED);
        save();
        renderAll();
        showToast('Sessie gereset');
      });

      document.querySelector('[data-action="print"]').addEventListener('click', () => {
        window.print();
      });

      const shareModal = document.getElementById('share-modal');
      const shareUrl = document.getElementById('share-url');
      document.querySelector('[data-action="share"]').addEventListener('click', () => {
        encodeToHash(state);
        shareUrl.value = location.href;
        shareModal.setAttribute('data-open', '');
        setTimeout(() => { shareUrl.select(); }, 50);
      });
      document.querySelectorAll('[data-close-modal]').forEach(b => {
        b.addEventListener('click', () => {
          shareModal.removeAttribute('data-open');
          clearHash();
        });
      });
      shareModal.addEventListener('click', (e) => {
        if (e.target === shareModal) {
          shareModal.removeAttribute('data-open');
          clearHash();
        }
      });
      document.getElementById('share-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          showToast('Link gekopieerd');
          shareModal.removeAttribute('data-open');
          clearHash();
        } catch {
          shareUrl.select();
          document.execCommand('copy');
          showToast('Link gekopieerd');
        }
      });

      renderAll();
    </script>
  </body>
</html>
