---
// Strategiesessie tool: één bord per onderwerp met vierkante post-its.
// State leeft in URL hash zodat de link gedeeld kan worden.
import '../styles/global.css';

const seed = {
  meta: { titel: 'Strategiesessie Klarijn' },
  boards: [
    {
      id: 'doelstellingen',
      label: 'Doelstellingen',
      vraag: 'Wat moet de website concreet bereiken?',
      notes: [
        { text: 'Direct contact stimuleren', c: 0 },
        { text: 'Vindbaarheid op juridische vragen', c: 2 },
        { text: 'Onderscheid van advocatenkantoor', c: 1 },
        { text: 'Klant en franchise gescheiden', c: 3 },
        { text: 'Beheer door eigen team', c: 4 },
      ],
    },
    {
      id: 'doelgroepen',
      label: 'Doelgroepen',
      vraag: 'Wie willen we bereiken?',
      notes: [
        { text: 'MKB met geschil', c: 3 },
        { text: 'Familiebedrijf in overdracht', c: 1 },
        { text: 'Cateraar of horeca', c: 4 },
        { text: 'Webshop met IE-vraag', c: 2 },
        { text: 'Jurist overweegt franchise', c: 0 },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Strategiesessie Klarijn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ag-indigo: #2d3fe0;
        --ag-indigo-hover: #1f2bb8;
        --ag-indigo-sky: #eef0fe;
        --ink: #0f0f12;
        --ink-soft: #56575c;
        --ink-muted: #8b8c93;
        --paper: #fafaf7;
        --board-bg: #f5f3ee;
        --border: rgba(15,15,18,0.08);
        --border-soft: rgba(15,15,18,0.05);
      }
      html, body {
        background: var(--paper);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      /* Top bar */
      .topbar {
        background: rgba(250,250,247,0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .brand-mark {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      /* Buttons */
      .btn {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 14px;
        border-radius: 8px;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }
      .btn-ghost {
        color: var(--ink-soft);
      }
      .btn-ghost:hover {
        background: var(--ag-indigo-sky);
        color: var(--ag-indigo);
      }
      .btn-primary {
        background: var(--ag-indigo);
        color: white;
        font-weight: 600;
      }
      .btn-primary:hover { background: var(--ag-indigo-hover); }

      /* Tabs (underline style) */
      .tab-bar {
        display: flex;
        gap: 28px;
        border-bottom: 1px solid var(--border);
        align-items: stretch;
      }
      .tab {
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink-soft);
        background: transparent;
        cursor: pointer;
        padding: 14px 2px;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color 0.15s, border-color 0.15s;
        display: inline-flex;
        align-items: center;
      }
      .tab:hover { color: var(--ink); }
      .tab[aria-selected="true"] {
        color: var(--ag-indigo);
        border-bottom-color: var(--ag-indigo);
        font-weight: 600;
      }
      .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 10px;
        min-width: 22px;
        height: 20px;
        padding: 0 7px;
        border-radius: 999px;
        background: rgba(15,15,18,0.06);
        color: var(--ink-muted);
        font-size: 11px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
      }
      .tab[aria-selected="true"] .tab-count {
        background: var(--ag-indigo-sky);
        color: var(--ag-indigo);
      }

      /* Board canvas */
      .board {
        background-color: var(--board-bg);
        background-image:
          linear-gradient(rgba(15,15,18,0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(15,15,18,0.025) 1px, transparent 1px);
        background-size: 28px 28px;
        background-position: -1px -1px;
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: 0 1px 2px rgba(15,15,18,0.03);
      }

      /* Post-it kleuren - verfijnde, gedempte palette */
      .pi-0 { background: #FCE7A0; }   /* butter */
      .pi-1 { background: #F8C9D9; }   /* dusty rose */
      .pi-2 { background: #D2E7CB; }   /* sage */
      .pi-3 { background: #C7D7ED; }   /* soft sky */
      .pi-4 { background: #F4D5B8; }   /* warm beige */

      .postit {
        position: relative;
        width: 144px;
        height: 144px;
        padding: 16px;
        box-shadow:
          0 1px 1px rgba(15,15,18,0.04),
          0 8px 16px -6px rgba(15,15,18,0.15);
        font-family: 'Caveat', cursive;
        font-size: 18px;
        line-height: 1.2;
        color: #1a1a1d;
        word-break: break-word;
        transition: transform 0.2s ease, box-shadow 0.2s ease, z-index 0s 0.2s;
        cursor: text;
        display: flex;
        align-items: flex-start;
        border-radius: 1px;
      }
      .postit:focus-within, .postit:hover {
        box-shadow:
          0 2px 4px rgba(15,15,18,0.06),
          0 18px 32px -8px rgba(15,15,18,0.22);
        transform: translateY(-3px) rotate(0deg) !important;
        z-index: 10;
        transition: transform 0.2s ease, box-shadow 0.2s ease, z-index 0s 0s;
      }
      .postit-text {
        outline: none;
        flex: 1;
        min-height: 100%;
        width: 100%;
      }
      .postit-text:empty::before {
        content: attr(data-placeholder);
        color: rgba(15,15,18,0.30);
        font-style: italic;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
      }
      .postit .x {
        position: absolute;
        top: 6px;
        right: 6px;
        opacity: 0;
        transition: opacity 0.15s;
        font-size: 14px;
        background: rgba(255,255,255,0.85);
        border-radius: 999px;
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        color: var(--ink-soft);
        line-height: 1;
        z-index: 2;
        border: 1px solid rgba(15,15,18,0.06);
      }
      .postit:hover .x, .postit:focus-within .x { opacity: 1; }
      .postit .x:hover { background: white; color: #c81e6b; }

      .add-postit {
        width: 144px;
        height: 144px;
        border: 1.5px dashed rgba(15,15,18,0.18);
        border-radius: 4px;
        display: grid;
        place-items: center;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink-muted);
        cursor: pointer;
        background: rgba(255,255,255,0.35);
        transition: all 0.15s;
        align-self: flex-start;
      }
      .add-postit:hover {
        background: white;
        border-color: var(--ag-indigo);
        color: var(--ag-indigo);
      }

      /* Typografie */
      .eyebrow {
        font-family: 'Outfit', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ag-indigo);
      }
      .display {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      @media print {
        .no-print { display: none !important; }
        .add-postit { display: none !important; }
        .postit { box-shadow: none; border: 1px solid #ccc; transform: none !important; }
        body { background: white; }
        .board { background: white; border: 1px solid #ddd; }
        .print-block { display: block !important; break-inside: avoid; page-break-before: always; }
        .print-block:first-child { page-break-before: auto; }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Top bar -->
    <header class="topbar sticky top-0 z-40 no-print">
      <div class="max-w-[1240px] mx-auto px-5 md:px-8 flex items-center justify-between gap-3 h-[56px]">
        <div class="flex items-center gap-2.5">
          <img src="/agensea-logo.png" alt="" width="22" height="22" class="rounded" />
          <span class="brand-mark text-[15px] text-[var(--ink)]">Agensea</span>
          <span class="text-[var(--ink-muted)] text-sm leading-none mx-0.5">/</span>
          <span class="brand-mark text-[15px] text-[var(--ink-soft)]">Klarijn</span>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" data-action="reset" class="btn btn-ghost">Reset</button>
          <button type="button" data-action="share" class="btn btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Delen
          </button>
          <button type="button" data-action="print" class="btn btn-primary ml-1">Export PDF</button>
        </div>
      </div>
    </header>

    <!-- Page header -->
    <section class="max-w-[1240px] mx-auto px-5 md:px-8 pt-10 md:pt-14 pb-6">
      <div class="eyebrow mb-3">Strategiesessie · 90 minuten</div>
      <h1 class="display text-3xl md:text-[34px] text-[var(--ink)] leading-tight mb-2">
        Klarijn website 2.0
      </h1>
      <p class="text-[15px] text-[var(--ink-soft)] max-w-[62ch] leading-relaxed">
        Twee onderwerpen, één bord per onderwerp. Plak per inzicht een post-it, één regel volstaat. De link is deelbaar, dus inzichten kunnen ook na afloop bijgevoegd worden.
      </p>
    </section>

    <!-- Tab bar -->
    <nav class="max-w-[1240px] mx-auto px-5 md:px-8 no-print">
      <div class="tab-bar" role="tablist" id="tabs"></div>
    </nav>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[var(--ink)] text-white text-sm px-4 py-2 rounded-full shadow-2xl pointer-events-none opacity-0 transition-opacity duration-300 z-50 no-print"></div>

    <!-- Boards -->
    <main class="max-w-[1240px] mx-auto px-5 md:px-8 pt-6 pb-16">
      <div id="boards"></div>

      <div class="pt-8 mt-6 border-t border-[var(--border)] flex flex-col sm:flex-row items-center justify-between gap-3 no-print">
        <p class="text-xs text-[var(--ink-muted)] m-0">
          Automatisch opgeslagen in browser. Wijzigingen zitten ook in de URL.
        </p>
        <div class="flex items-center gap-2 text-xs text-[var(--ink-muted)]">
          <img src="/agensea-logo.png" alt="" width="14" height="14" class="rounded" />
          <span>Agensea sessietool</span>
        </div>
      </div>
    </main>

    <!-- Share modal -->
    <div id="share-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center p-4 no-print" style="display:none">
      <div class="bg-white rounded-xl p-7 md:p-8 max-w-md w-full shadow-2xl border border-[var(--border)]">
        <h3 class="display text-xl text-[var(--ink)] mb-2">Sessie delen</h3>
        <p class="text-sm text-[var(--ink-soft)] mb-4 leading-relaxed">
          Deze link bevat alle huidige post-its. Stuur naar de klant of collega; zij zien bij openen exact wat hier staat en kunnen zelf bijplakken.
        </p>
        <div class="flex gap-2 mb-4">
          <input id="share-url" type="text" readonly
                 class="flex-1 bg-[var(--paper)] border border-[var(--border)] rounded-lg px-3 py-2 text-xs font-mono text-[var(--ink-soft)] focus:outline-none" />
          <button id="share-copy" type="button" class="btn btn-primary">Kopieer</button>
        </div>
        <p class="text-xs text-[var(--ink-muted)] mb-4 leading-relaxed">
          Wijzigingen aan hun kant zijn pas zichtbaar wanneer zij hun bijgewerkte link terugsturen.
        </p>
        <button type="button" data-close-modal class="text-sm font-medium text-[var(--ink-soft)] hover:text-[var(--ink)] w-full text-center pt-3 border-t border-[var(--border)]">
          Sluiten
        </button>
      </div>
    </div>

    <script type="application/json" id="seed" set:html={JSON.stringify(seed)}></script>

    <script>
      const seedEl = document.getElementById('seed');
      const SEED = JSON.parse(seedEl.textContent);
      const clone = (o) => JSON.parse(JSON.stringify(o));

      const LS_KEY = 'klarijn_strategie_v5';
      let state;
      let activeTab = 0;

      function decodeFromHash() {
        const m = location.hash.match(/^#s=(.+)$/);
        if (!m) return null;
        try {
          const json = decodeURIComponent(escape(atob(decodeURIComponent(m[1]))));
          return JSON.parse(json);
        } catch { return null; }
      }
      function encodeToHash(s) {
        try {
          const json = JSON.stringify(s);
          const b64 = btoa(unescape(encodeURIComponent(json)));
          history.replaceState(null, '', '#s=' + encodeURIComponent(b64));
        } catch {}
      }

      const fromHash = decodeFromHash();
      if (fromHash && fromHash.boards) {
        state = fromHash;
      } else {
        try {
          const stored = localStorage.getItem(LS_KEY);
          state = stored ? JSON.parse(stored) : clone(SEED);
        } catch {
          state = clone(SEED);
        }
      }
      if (!state.boards) state.boards = clone(SEED.boards);

      let saveTimer = null;
      function save() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch {}
          encodeToHash(state);
        }, 200);
      }

      const tabsEl = document.getElementById('tabs');
      const boardsEl = document.getElementById('boards');

      function rndRotation() {
        return (Math.random() * 4 - 2).toFixed(2);
      }

      function makePostit(board, idx) {
        const note = board.notes[idx];
        const el = document.createElement('div');
        el.className = `postit pi-${note.c ?? 0}`;
        el.style.setProperty('--rot', (note.rot ?? rndRotation()) + 'deg');
        el.style.transform = `rotate(var(--rot))`;
        el.innerHTML = `
          <button class="x" type="button" title="Verwijder" tabindex="-1">×</button>
          <div class="postit-text" contenteditable="true" data-placeholder="schrijf...">${escapeHtml(note.text || '')}</div>
        `;
        const text = el.querySelector('.postit-text');
        text.addEventListener('input', () => { note.text = text.textContent; save(); });
        text.addEventListener('blur', () => {
          if (!note.text || !note.text.trim()) {
            const i = board.notes.indexOf(note);
            if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
          }
        });
        el.querySelector('.x').addEventListener('click', (e) => {
          e.stopPropagation();
          const i = board.notes.indexOf(note);
          if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
        });
        return el;
      }

      function makeAddBtn(board) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'add-postit';
        btn.innerHTML = `<span>+ post-it</span>`;
        btn.addEventListener('click', () => {
          const c = Math.floor(Math.random() * 5);
          board.notes.push({ text: '', c, rot: rndRotation() });
          save();
          renderAll();
          setTimeout(() => {
            const allNotes = document.querySelectorAll(`[data-board="${board.id}"] .postit-text`);
            const last = allNotes[allNotes.length - 1];
            last?.focus();
          }, 30);
        });
        return btn;
      }

      function makeBoard(board, isPrint = false) {
        const section = document.createElement('section');
        section.className = 'print-block';
        section.dataset.board = board.id;
        section.innerHTML = `
          <header class="mb-4 flex items-baseline justify-between gap-3 flex-wrap">
            <div>
              <div class="eyebrow mb-1">${escapeHtml(board.label)}</div>
              <h2 class="display text-2xl md:text-[28px] text-[var(--ink)] leading-tight m-0">${escapeHtml(board.vraag)}</h2>
            </div>
            <div class="text-xs text-[var(--ink-muted)]">
              ${board.notes.length} ${board.notes.length === 1 ? 'post-it' : 'post-its'}
            </div>
          </header>
          <div class="board p-6 md:p-8">
            <div class="flex flex-wrap gap-5 items-start postit-wall min-h-[280px]"></div>
          </div>
        `;
        const wall = section.querySelector('.postit-wall');
        board.notes.forEach((_, idx) => {
          wall.appendChild(makePostit(board, idx));
        });
        wall.appendChild(makeAddBtn(board));
        return section;
      }

      function renderTabs() {
        tabsEl.innerHTML = '';
        state.boards.forEach((b, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.role = 'tab';
          btn.className = 'tab';
          btn.setAttribute('aria-selected', i === activeTab ? 'true' : 'false');
          btn.innerHTML = `<span>${escapeHtml(b.label)}</span><span class="tab-count">${b.notes.length}</span>`;
          btn.addEventListener('click', () => {
            activeTab = i;
            renderAll();
          });
          tabsEl.appendChild(btn);
        });
      }

      function renderBoards() {
        boardsEl.innerHTML = '';
        const active = state.boards[activeTab];
        if (active) {
          const section = makeBoard(active);
          boardsEl.appendChild(section);
        }
        state.boards.forEach((b, i) => {
          if (i === activeTab) return;
          const section = makeBoard(b, true);
          section.classList.add('hidden', 'print:block');
          section.style.marginTop = '32px';
          boardsEl.appendChild(section);
        });
      }

      function renderAll() {
        renderTabs();
        renderBoards();
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.opacity = '1';
        setTimeout(() => { t.style.opacity = '0'; }, 1800);
      }

      document.querySelector('[data-action="reset"]').addEventListener('click', () => {
        if (!confirm('Alle post-its weg en terug naar de pre-fill?')) return;
        state = clone(SEED);
        save();
        renderAll();
        showToast('Sessie gereset');
      });

      document.querySelector('[data-action="print"]').addEventListener('click', () => {
        window.print();
      });

      const shareModal = document.getElementById('share-modal');
      const shareUrl = document.getElementById('share-url');
      document.querySelector('[data-action="share"]').addEventListener('click', () => {
        encodeToHash(state);
        shareUrl.value = location.href;
        shareModal.style.display = 'flex';
      });
      document.querySelectorAll('[data-close-modal]').forEach(b => {
        b.addEventListener('click', () => { shareModal.style.display = 'none'; });
      });
      shareModal.addEventListener('click', (e) => {
        if (e.target === shareModal) shareModal.style.display = 'none';
      });
      document.getElementById('share-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          showToast('Link gekopieerd');
          shareModal.style.display = 'none';
        } catch {
          shareUrl.select();
          document.execCommand('copy');
          showToast('Link gekopieerd');
        }
      });

      renderAll();
      encodeToHash(state);
    </script>
  </body>
</html>
