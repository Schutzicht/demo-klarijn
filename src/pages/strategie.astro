    <script type="application/json" id="defaults" set:html={JSON.stringify(defaults)}></script>

    <style is:global>
      [contenteditable="true"]:empty::before {
        content: attr(data-placeholder);
        color: rgba(94, 31, 92, 0.35);
        font-style: italic;
      }
      [contenteditable="true"] {
        outline: none;
      }
      [contenteditable="true"]:focus {
        background: rgba(224, 39, 122, 0.04);
        border-radius: 4px;
      }
      .bullet-item:hover .bullet-remove { opacity: 1; }
      .bullet-remove { opacity: 0; transition: opacity 0.15s; }
      @media print {
        body { background: white !important; }
        .bg-white, .bg-paper-2 { background: white !important; box-shadow: none !important; }
        button { display: none !important; }
        input, textarea { border: none !important; padding: 0 !important; }
        textarea { resize: none !important; }
        section { page-break-inside: avoid; }
        h1, h2, h3 { page-break-after: avoid; }
      }
    </style>

    <script>
      const KEY = 'klarijn_strategie_v1';
      const defaultsEl = document.getElementById('defaults');
      const DEFAULTS = JSON.parse(defaultsEl.textContent);

      // Deep clone helper
      const clone = (o) => JSON.parse(JSON.stringify(o));

      // Path helpers: get/set via 'a.b.c' notation
      function getPath(obj, path) {
        return path.split('.').reduce((o, k) => (o ? o[k] : undefined), obj);
      }
      function setPath(obj, path, value) {
        const keys = path.split('.');
        const last = keys.pop();
        const target = keys.reduce((o, k) => o[k] = o[k] || {}, obj);
        target[last] = value;
      }

      // State
      let state;
      try {
        const stored = localStorage.getItem(KEY);
        state = stored ? JSON.parse(stored) : clone(DEFAULTS);
      } catch {
        state = clone(DEFAULTS);
      }

      const save = () => {
        try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
      };

      // ----- Rendering -----
      function renderBulletList(ul, path) {
        ul.innerHTML = '';
        const items = getPath(state, path) || [];
        items.forEach((it, idx) => {
          const li = document.createElement('li');
          li.className = 'bullet-item flex gap-3 items-start group';
          li.innerHTML = `
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-magenta shrink-0"></span>
            <div class="flex-1 min-w-0">
              <div contenteditable="true" data-placeholder="Korte titel" class="font-semibold text-ink text-sm leading-snug">${escapeHtml(it.titel || '')}</div>
              <div contenteditable="true" data-placeholder="Toelichting…" class="text-ink-soft text-sm leading-relaxed mt-0.5">${escapeHtml(it.tekst || '')}</div>
            </div>
            <button type="button" class="bullet-remove text-ink-soft hover:text-magenta text-lg leading-none shrink-0 px-1" aria-label="Verwijder">×</button>
          `;
          const [titleEl, textEl] = li.querySelectorAll('[contenteditable]');
          titleEl.addEventListener('input', () => { items[idx].titel = titleEl.textContent; save(); });
          textEl.addEventListener('input', () => { items[idx].tekst = textEl.textContent; save(); });
          li.querySelector('.bullet-remove').addEventListener('click', () => {
            items.splice(idx, 1); save(); renderBulletList(ul, path);
          });
          ul.appendChild(li);
        });
      }

      function renderSimpleList(ul, path) {
        ul.innerHTML = '';
        const items = getPath(state, path) || [];
        items.forEach((text, idx) => {
          const li = document.createElement('li');
          li.className = 'bullet-item flex gap-2.5 items-start group';
          li.innerHTML = `
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-magenta shrink-0"></span>
            <div contenteditable="true" data-placeholder="Voeg een punt toe…" class="flex-1 text-ink leading-relaxed">${escapeHtml(text || '')}</div>
            <button type="button" class="bullet-remove text-ink-soft hover:text-magenta text-base leading-none shrink-0 px-1" aria-label="Verwijder">×</button>
          `;
          const editable = li.querySelector('[contenteditable]');
          editable.addEventListener('input', () => { items[idx] = editable.textContent; save(); });
          li.querySelector('.bullet-remove').addEventListener('click', () => {
            items.splice(idx, 1); save(); renderSimpleList(ul, path);
          });
          ul.appendChild(li);
        });
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }

      // Bind input/textarea fields by data-key
      function bindInputs() {
        document.querySelectorAll('[data-key]').forEach(el => {
          const path = el.dataset.key;
          el.value = getPath(state, path) || '';
          el.addEventListener('input', () => {
            setPath(state, path, el.value);
            save();
          });
        });
      }

      // Render all lists
      function renderAll() {
        document.querySelectorAll('[data-list]').forEach(ul => renderBulletList(ul, ul.dataset.list));
        document.querySelectorAll('[data-simplelist]').forEach(ul => renderSimpleList(ul, ul.dataset.simplelist));
        bindInputs();
      }

      // Add buttons (rich bullets)
      document.querySelectorAll('[data-add]').forEach(btn => {
        btn.addEventListener('click', () => {
          const path = btn.dataset.add;
          const list = getPath(state, path) || [];
          list.push({ titel: '', tekst: '' });
          setPath(state, path, list);
          save();
          const ul = document.querySelector(`[data-list="${path}"]`);
          if (ul) {
            renderBulletList(ul, path);
            const newItem = ul.lastElementChild?.querySelector('[contenteditable]');
            newItem?.focus();
          }
        });
      });

      // Add buttons (simple lists)
      document.querySelectorAll('[data-add-simple]').forEach(btn => {
        btn.addEventListener('click', () => {
          const path = btn.dataset.addSimple;
          const list = getPath(state, path) || [];
          list.push('');
          setPath(state, path, list);
          save();
          const ul = document.querySelector(`[data-simplelist="${path}"]`);
          if (ul) {
            renderSimpleList(ul, path);
            const newItem = ul.lastElementChild?.querySelector('[contenteditable]');
            newItem?.focus();
          }
        });
      });

      // Reset
      document.querySelector('[data-action="reset"]')?.addEventListener('click', () => {
        if (!confirm('Weet je zeker dat je alle wijzigingen wil weggooien en terug wil naar de pre-fill?')) return;
        state = clone(DEFAULTS);
        save();
        renderAll();
      });

      // Print
      document.querySelector('[data-action="print"]')?.addEventListener('click', () => {
        window.print();
      });

      // Copy as markdown
      document.querySelector('[data-action="copy-md"]')?.addEventListener('click', async () => {
        const md = toMarkdown(state);
        try {
          await navigator.clipboard.writeText(md);
          alert('Gekopieerd naar klembord!');
        } catch {
          alert('Kopiëren mislukt — selecteer handmatig:\n\n' + md.slice(0, 500) + '...');
        }
      });

      function bullets(items, simple = false) {
        if (!items || !items.length) return '_(leeg)_\n';
        return items.map(i => simple ? `- ${i}` : `- **${i.titel}** — ${i.tekst}`).join('\n') + '\n';
      }

      function toMarkdown(s) {
        return `# Strategische sessie Klarijn

**Datum:** ${s.meta?.sessieDatum || '—'}
**Facilitator:** ${s.meta?.facilitator || '—'}
**Deelnemers:**
${s.meta?.deelnemers || '—'}

---

## 1. Stip op de horizon

### Doelen van de nieuwe website
${bullets(s.doelen)}
### Succesfactoren
${bullets(s.succesfactoren)}
### USP's
${bullets(s.usps)}
---

## 2. Doelgroepen

### Primaire doelgroepen
${bullets(s.doelgroepen?.primair, true)}
### Secundaire doelgroepen
${bullets(s.doelgroepen?.secundair, true)}
### Kenmerken bezoekers
${bullets(s.doelgroepen?.kenmerken, true)}

### Persona 1: ${s.persona1?.naam || ''}
${s.persona1?.omschrijving || ''}

**Doel op de website**
${bullets(s.persona1?.doel, true)}
**Wanneer in aanraking**
${bullets(s.persona1?.wanneer, true)}
**Vragen**
${bullets(s.persona1?.vragen, true)}
**Pijnpunten**
${bullets(s.persona1?.pijnpunten, true)}
**Wensen**
${bullets(s.persona1?.wensen, true)}
**Aandachtspunten**
${bullets(s.persona1?.aandachtspunten, true)}

### Persona 2: ${s.persona2?.naam || ''}
${s.persona2?.omschrijving || ''}

**Doel op de website**
${bullets(s.persona2?.doel, true)}
**Wanneer in aanraking**
${bullets(s.persona2?.wanneer, true)}
**Vragen**
${bullets(s.persona2?.vragen, true)}
**Pijnpunten**
${bullets(s.persona2?.pijnpunten, true)}
**Wensen**
${bullets(s.persona2?.wensen, true)}
**Aandachtspunten**
${bullets(s.persona2?.aandachtspunten, true)}

---

## 3. Aandachtspunten
${bullets(s.aandachtspunten)}
---

## 4. Vervolgstappen
${bullets(s.vervolgstappen, true)}
---

## 5. Vrije notities
${s.notities || '—'}
`;
      }

      // Init
      renderAll();
    </script>
  </body>
</html>
