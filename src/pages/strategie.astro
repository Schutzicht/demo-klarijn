---
// Strategische werksessie als post-it bord.
// Hoofdlijnen, één regel per gedachte. State leeft in URL (deelbaar).
import '../styles/global.css';

// Pre-fill: heel minimaal, alleen om de boel op gang te helpen.
const seed = {
  meta: { titel: 'Agensea Plakbord · Klarijn' },
  zones: [
    {
      id: 'koppig',
      vraag: 'Waar zijn we koppig over?',
      hint: 'De dingen die niet onderhandelbaar zijn. Eén regel per overtuiging.',
      notes: [
        { text: 'Vaste prijs vooraf', c: 0 },
        { text: 'Eén vaste jurist, geen draaideur', c: 1 },
        { text: 'Plain Nederlands', c: 2 },
      ],
    },
    {
      id: 'binnenwandelt',
      vraag: 'Wie tikt deze site binnen?',
      hint: 'Type mens. Wat voor ondernemer of jurist staat er voor de deur?',
      notes: [
        { text: 'Aannemer met geschil', c: 3 },
        { text: 'Familiebedrijf voor overdracht', c: 4 },
        { text: 'Jurist die franchise overweegt', c: 0 },
      ],
    },
    {
      id: 'eerste-klik',
      vraag: 'Wat is de eerste klik?',
      hint: 'Eén hoofdactie waar alles op stuurt. Niet meer.',
      notes: [
        { text: 'Bellen of WhatsAppen', c: 2 },
      ],
    },
    {
      id: 'energie',
      vraag: 'Welke energie ademt de site?',
      hint: 'Korte woorden. Stoer? Warm? Streetwise? Verzorgd? Allebei?',
      notes: [
        { text: 'Niet glad', c: 1 },
        { text: 'Wel verzorgd', c: 4 },
      ],
    },
    {
      id: 'stekker',
      vraag: 'Waar trekken we de stekker uit?',
      hint: 'Conventies die andere kantoren wel doen, en wij niet.',
      notes: [
        { text: 'Geen ivoren toren', c: 3 },
        { text: 'Geen 14-pagina formulier', c: 0 },
      ],
    },
    {
      id: 'losse',
      vraag: 'Losse eindjes',
      hint: 'Wat blijft hangen, hoort nergens, maar mag niet vergeten.',
      notes: [],
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Strategische sessie · Klarijn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ag-indigo: #2d3fe0;
        --ag-indigo-light: #4f5ef7;
        --ag-indigo-sky: #e8eafe;
        --ag-cream: #faf9f6;
        --ag-dark: #0d0d0d;
      }
      html, body {
        background: var(--ag-cream);
        font-family: 'Inter', system-ui, sans-serif;
        color: #2a2a2a;
      }
      /* Post-it kleuren (5 stuks, c=0..4) */
      .pi-0 { background: #FFF38A; }   /* geel */
      .pi-1 { background: #FFC4D6; }   /* roze */
      .pi-2 { background: #C4F2DA; }   /* mint */
      .pi-3 { background: #C4DCFF; }   /* blauw */
      .pi-4 { background: #FFD9B5; }   /* perzik */
      .postit {
        position: relative;
        padding: 16px 18px 18px;
        min-width: 130px;
        max-width: 220px;
        box-shadow: 0 6px 14px -4px rgba(13,13,13,0.12), 0 2px 4px rgba(13,13,13,0.06);
        font-family: 'Caveat', cursive;
        font-size: 1.25rem;
        line-height: 1.25;
        color: #2a2a2a;
        word-break: break-word;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        cursor: text;
      }
      .postit:focus-within, .postit:hover {
        box-shadow: 0 12px 24px -6px rgba(13,13,13,0.18), 0 4px 8px rgba(13,13,13,0.08);
        transform: translateY(-2px) rotate(0deg) !important;
        z-index: 5;
      }
      .postit-text {
        outline: none;
        min-width: 100px;
      }
      .postit-text:empty::before {
        content: attr(data-placeholder);
        color: rgba(13,13,13,0.32);
        font-style: italic;
      }
      .postit .x {
        position: absolute;
        top: 4px;
        right: 6px;
        opacity: 0;
        transition: opacity 0.15s;
        font-size: 1rem;
        background: rgba(255,255,255,0.6);
        border-radius: 50%;
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        color: #555;
        line-height: 1;
      }
      .postit:hover .x, .postit:focus-within .x { opacity: 1; }
      .postit .x:hover { background: white; color: #c81e6b; }
      .add-postit {
        min-width: 130px;
        min-height: 80px;
        border: 2px dashed rgba(13,13,13,0.18);
        border-radius: 6px;
        display: grid;
        place-items: center;
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        color: rgba(13,13,13,0.45);
        cursor: pointer;
        background: rgba(255,255,255,0.4);
        transition: all 0.15s;
      }
      .add-postit:hover {
        background: white;
        border-color: var(--ag-indigo);
        color: var(--ag-indigo);
        transform: translateY(-2px);
      }
      @media print {
        .no-print { display: none !important; }
        .add-postit { display: none !important; }
        .postit { box-shadow: none; border: 1px solid #ddd; transform: none !important; }
        body { background: white; }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Top toolbar -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-black/8 no-print">
      <div class="max-w-[1180px] mx-auto px-4 md:px-8 flex items-center justify-between gap-3 h-14">
        <div class="flex items-center gap-3">
          <img src="/agensea-logo.png" alt="Agensea" width="20" height="20" class="rounded" />
          <span class="font-semibold text-[15px] text-[#0d0d0d] tracking-tight" style="font-family:'Outfit',sans-serif">Agensea Hub</span>
          <span class="text-black/30 text-sm">×</span>
          <span class="font-display text-lg text-[#5E1F5C]">Klarijn</span>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" data-action="reset"
            class="text-xs font-medium text-black/55 hover:text-black hover:bg-[var(--ag-indigo-sky)] px-3 py-1.5 rounded-full transition-colors">
            Reset
          </button>
          <button type="button" data-action="share"
            class="text-xs font-medium text-black hover:bg-[var(--ag-indigo-sky)] hover:text-[var(--ag-indigo)] px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Link delen
          </button>
          <button type="button" data-action="print"
            class="text-xs font-semibold text-white px-4 py-1.5 rounded-full transition-colors"
            style="background: var(--ag-indigo)">
            PDF
          </button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-[1180px] mx-auto px-4 md:px-8 pt-10 md:pt-14 pb-4">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="text-[.65rem] font-bold uppercase tracking-[.2em] text-[var(--ag-indigo)]" style="font-family:'Outfit',sans-serif">
          Agensea Plakbord · 90 minuten
        </span>
      </div>
      <h1 class="font-display text-4xl md:text-6xl text-[#5E1F5C] leading-[.95] mb-4">
        Plak je gedachten<br/>
        <span style="color: #E0277A">over Klarijn</span>
      </h1>
      <p class="text-base md:text-lg text-black/65 max-w-[58ch] leading-relaxed mb-2">
        Eén regel per post-it. Geen volle zinnen. Klik op een lege plek om er één bij te plakken.
      </p>
      <p class="text-sm text-black/45 max-w-[58ch] leading-relaxed">
        Deel de link met je team — iedereen kan vanuit eigen browser meeplakken. De huidige post-its zitten in de URL.
      </p>
    </section>

    <!-- Toast voor copy/share feedback -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#0d0d0d] text-white text-sm px-4 py-2 rounded-full shadow-2xl pointer-events-none opacity-0 transition-opacity duration-300 z-50 no-print"></div>

    <main class="max-w-[1180px] mx-auto px-4 md:px-8 pb-32 space-y-12" id="board"></main>

    <!-- Share modal -->
    <div id="share-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center p-4 no-print" style="display:none">
      <div class="bg-white rounded-2xl p-7 md:p-9 max-w-md w-full shadow-2xl">
        <h3 class="font-display text-2xl text-[#5E1F5C] mb-2">Deel deze sessie</h3>
        <p class="text-sm text-black/65 mb-4 leading-relaxed">
          Stuur deze link naar je klant of collega. De huidige post-its zitten in de link verwerkt — ze zien bij openen wat jij hebt geplakt.
        </p>
        <div class="flex gap-2 mb-4">
          <input id="share-url" type="text" readonly
                 class="flex-1 bg-[#faf9f6] border border-black/10 rounded-lg px-3 py-2 text-xs font-mono text-black/70 focus:outline-none" />
          <button id="share-copy" type="button"
                  class="text-xs font-semibold text-white px-4 py-2 rounded-lg transition-colors"
                  style="background: var(--ag-indigo)">
            Kopieer
          </button>
        </div>
        <p class="text-xs text-black/50 mb-4 leading-relaxed">
          Tip: wijzigingen die zij maken zien jij alleen als zij hun bijgewerkte link terugsturen. Geen real-time sync.
        </p>
        <button type="button" data-close-modal class="text-sm font-medium text-black/55 hover:text-black w-full text-center pt-2 border-t border-black/10">
          Sluiten
        </button>
      </div>
    </div>

    <script type="application/json" id="seed" set:html={JSON.stringify(seed)}></script>

    <script>
      const seedEl = document.getElementById('seed');
      const SEED = JSON.parse(seedEl.textContent);
      const clone = (o) => JSON.parse(JSON.stringify(o));

      // ----- State init: try URL hash, else localStorage, else seed -----
      const LS_KEY = 'klarijn_strategie_v2';
      let state;

      function decodeFromHash() {
        const m = location.hash.match(/^#s=(.+)$/);
        if (!m) return null;
        try {
          const json = decodeURIComponent(escape(atob(decodeURIComponent(m[1]))));
          return JSON.parse(json);
        } catch { return null; }
      }
      function encodeToHash(s) {
        try {
          const json = JSON.stringify(s);
          const b64 = btoa(unescape(encodeURIComponent(json)));
          history.replaceState(null, '', '#s=' + encodeURIComponent(b64));
        } catch {}
      }

      const fromHash = decodeFromHash();
      if (fromHash) {
        state = fromHash;
      } else {
        try {
          const stored = localStorage.getItem(LS_KEY);
          state = stored ? JSON.parse(stored) : clone(SEED);
        } catch {
          state = clone(SEED);
        }
      }
      // Migrate: missing zones from seed
      if (!state.zones) state.zones = clone(SEED.zones);

      let saveTimer = null;
      function save() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch {}
          encodeToHash(state);
        }, 200);
      }

      // ----- Rendering -----
      const board = document.getElementById('board');

      function rndRotation() {
        return (Math.random() * 6 - 3).toFixed(2);  // -3 tot +3 graden
      }

      function makePostit(zone, idx) {
        const note = zone.notes[idx];
        const el = document.createElement('div');
        el.className = `postit pi-${note.c ?? 0}`;
        el.style.setProperty('--rot', (note.rot ?? rndRotation()) + 'deg');
        el.style.transform = `rotate(var(--rot))`;
        el.innerHTML = `
          <button class="x" type="button" title="Verwijder" tabindex="-1">×</button>
          <div class="postit-text" contenteditable="true" data-placeholder="schrijf...">${escapeHtml(note.text || '')}</div>
        `;
        const text = el.querySelector('.postit-text');
        text.addEventListener('input', () => { note.text = text.textContent; save(); });
        text.addEventListener('blur', () => {
          if (!note.text || !note.text.trim()) {
            // Verwijder lege post-its bij blur
            const i = zone.notes.indexOf(note);
            if (i >= 0) { zone.notes.splice(i, 1); save(); renderAll(); }
          }
        });
        el.querySelector('.x').addEventListener('click', (e) => {
          e.stopPropagation();
          const i = zone.notes.indexOf(note);
          if (i >= 0) { zone.notes.splice(i, 1); save(); renderAll(); }
        });
        return el;
      }

      function makeAddBtn(zone) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'add-postit';
        btn.innerHTML = `<span>+ post-it</span>`;
        btn.addEventListener('click', () => {
          const c = Math.floor(Math.random() * 5);
          zone.notes.push({ text: '', c, rot: rndRotation() });
          save();
          renderAll();
          // Focus de nieuwe post-it
          setTimeout(() => {
            const allNotes = board.querySelectorAll(`[data-zone="${zone.id}"] .postit-text`);
            const last = allNotes[allNotes.length - 1];
            last?.focus();
          }, 30);
        });
        return btn;
      }

      function renderZone(zone) {
        const section = document.createElement('section');
        section.dataset.zone = zone.id;
        section.innerHTML = `
          <div class="flex items-baseline gap-3 mb-1">
            <h2 class="font-display text-2xl md:text-3xl text-[#5E1F5C] leading-tight">${escapeHtml(zone.vraag)}</h2>
          </div>
          <p class="text-sm text-black/50 mb-5 max-w-[55ch]">${escapeHtml(zone.hint || '')}</p>
          <div class="flex flex-wrap gap-4 items-start postit-wall"></div>
        `;
        const wall = section.querySelector('.postit-wall');
        zone.notes.forEach((_, idx) => {
          wall.appendChild(makePostit(zone, idx));
        });
        wall.appendChild(makeAddBtn(zone));
        return section;
      }

      function renderAll() {
        board.innerHTML = '';
        state.zones.forEach(z => board.appendChild(renderZone(z)));
        // Footer
        const footer = document.createElement('div');
        footer.className = 'pt-8 border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-3 no-print';
        footer.innerHTML = `
          <p class="text-xs text-black/50 m-0">
            Auto-save in browser. Wijzigingen ook bewaard in de URL — link delen = sessie delen.
          </p>
          <div class="flex items-center gap-2">
            <img src="/agensea-logo.png" alt="Agensea" width="18" height="18" class="rounded" />
            <span class="text-xs font-semibold" style="font-family:'Outfit',sans-serif">Agensea Hub</span>
            <span class="text-black/30 text-xs">×</span>
            <span class="font-display text-xs text-[#5E1F5C]">Klarijn</span>
          </div>
        `;
        board.appendChild(footer);
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.opacity = '1';
        setTimeout(() => { t.style.opacity = '0'; }, 1800);
      }

      // ----- Actions -----
      document.querySelector('[data-action="reset"]').addEventListener('click', () => {
        if (!confirm('Alle post-its weg en terug naar de pre-fill. Zeker weten?')) return;
        state = clone(SEED);
        save();
        renderAll();
        showToast('Sessie gereset');
      });

      document.querySelector('[data-action="print"]').addEventListener('click', () => {
        window.print();
      });

      const shareModal = document.getElementById('share-modal');
      const shareUrl = document.getElementById('share-url');
      document.querySelector('[data-action="share"]').addEventListener('click', () => {
        // Forceer URL update voor we 'm tonen
        encodeToHash(state);
        shareUrl.value = location.href;
        shareModal.style.display = 'flex';
      });
      document.querySelectorAll('[data-close-modal]').forEach(b => {
        b.addEventListener('click', () => { shareModal.style.display = 'none'; });
      });
      shareModal.addEventListener('click', (e) => {
        if (e.target === shareModal) shareModal.style.display = 'none';
      });
      document.getElementById('share-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          showToast('Link gekopieerd');
          shareModal.style.display = 'none';
        } catch {
          shareUrl.select();
          document.execCommand('copy');
          showToast('Link gekopieerd');
        }
      });

      // Initial render
      renderAll();
      // Ensure hash is set on first paint
      encodeToHash(state);
    </script>
  </body>
</html>
