---
// Strategiesessie: twee borden (Doelstellingen, Doelgroepen) met vierkante post-its.
// State leeft in URL hash zodat de link gedeeld kan worden.
import '../styles/global.css';

const seed = {
  meta: { titel: 'Strategiesessie Klarijn' },
  boards: [
    {
      id: 'doelstellingen',
      label: 'Doelstellingen',
      hint: 'Wat moet de website concreet bereiken?',
      notes: [
        { text: 'Direct contact stimuleren', c: 0 },
        { text: 'Vindbaarheid op juridische vragen', c: 2 },
        { text: 'Onderscheid van advocatenkantoor', c: 1 },
        { text: 'Klant en franchise gescheiden', c: 3 },
        { text: 'Beheer door eigen team', c: 4 },
      ],
    },
    {
      id: 'doelgroepen',
      label: 'Doelgroepen',
      hint: 'Wie willen we bereiken? Type bezoeker of branche.',
      notes: [
        { text: 'MKB met geschil', c: 3 },
        { text: 'Familiebedrijf in overdracht', c: 1 },
        { text: 'Cateraar of horeca', c: 4 },
        { text: 'Webshop met IE-vraag', c: 2 },
        { text: 'Jurist overweegt franchise', c: 0 },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Strategiesessie Klarijn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Outfit:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ag-indigo: #2d3fe0;
        --ag-indigo-sky: #e8eafe;
        --ag-cream: #f4f1ec;
        --ag-dark: #0d0d0d;
        --board-bg: #efeae0;
      }
      html, body {
        background: var(--ag-cream);
        font-family: 'Inter', system-ui, sans-serif;
        color: #2a2a2a;
      }
      /* Board: papier-textuur via subtiele dots */
      .board {
        background-color: var(--board-bg);
        background-image:
          radial-gradient(rgba(0,0,0,0.04) 1px, transparent 1px);
        background-size: 22px 22px;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.03), 0 1px 2px rgba(0,0,0,0.04);
      }
      /* Vijf post-it kleuren */
      .pi-0 { background: #FFEC8B; }
      .pi-1 { background: #FFB8CE; }
      .pi-2 { background: #B8F2D4; }
      .pi-3 { background: #B8D4FF; }
      .pi-4 { background: #FFCFA8; }
      .postit {
        position: relative;
        width: 128px;
        height: 128px;
        padding: 14px;
        box-shadow:
          0 1px 1px rgba(0,0,0,0.05),
          0 8px 14px -5px rgba(0,0,0,0.18),
          inset 0 -10px 16px -10px rgba(0,0,0,0.08);
        font-family: 'Caveat', cursive;
        font-size: 1.1rem;
        line-height: 1.15;
        color: #1f1f1f;
        word-break: break-word;
        transition: transform 0.18s ease, box-shadow 0.18s ease, z-index 0s 0.18s;
        cursor: text;
        display: flex;
        align-items: flex-start;
      }
      .postit::after {
        content: '';
        position: absolute;
        right: 0;
        bottom: 0;
        width: 16px;
        height: 16px;
        background: linear-gradient(135deg, transparent 50%, rgba(0,0,0,0.09) 50%);
      }
      .postit:focus-within, .postit:hover {
        box-shadow:
          0 2px 3px rgba(0,0,0,0.06),
          0 20px 32px -8px rgba(0,0,0,0.24),
          inset 0 -10px 16px -10px rgba(0,0,0,0.08);
        transform: translateY(-4px) rotate(0deg) !important;
        z-index: 10;
        transition: transform 0.18s ease, box-shadow 0.18s ease, z-index 0s 0s;
      }
      .postit-text {
        outline: none;
        flex: 1;
        min-height: 100%;
      }
      .postit-text:empty::before {
        content: attr(data-placeholder);
        color: rgba(0,0,0,0.32);
        font-style: italic;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
      }
      .postit .x {
        position: absolute;
        top: 4px;
        right: 4px;
        opacity: 0;
        transition: opacity 0.15s;
        font-size: 0.95rem;
        background: rgba(255,255,255,0.7);
        border-radius: 50%;
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        color: #555;
        line-height: 1;
        z-index: 2;
      }
      .postit:hover .x, .postit:focus-within .x { opacity: 1; }
      .postit .x:hover { background: white; color: #c81e6b; }
      .add-postit {
        width: 128px;
        height: 128px;
        border: 2px dashed rgba(0,0,0,0.20);
        border-radius: 4px;
        display: grid;
        place-items: center;
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        color: rgba(0,0,0,0.45);
        cursor: pointer;
        background: rgba(255,255,255,0.35);
        transition: all 0.15s;
        align-self: flex-start;
      }
      .add-postit:hover {
        background: rgba(255,255,255,0.7);
        border-color: var(--ag-indigo);
        color: var(--ag-indigo);
        transform: translateY(-2px);
      }
      /* Tabs */
      .tab {
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 999px;
        color: rgba(0,0,0,0.5);
        background: transparent;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
      }
      .tab:hover { background: rgba(255,255,255,0.6); color: #1f1f1f; }
      .tab[aria-selected="true"] {
        background: var(--ag-indigo);
        color: white;
        box-shadow: 0 6px 14px -4px rgba(45,63,224,0.4);
      }
      .tab-count {
        display: inline-block;
        margin-left: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 1px 8px;
        border-radius: 999px;
        background: rgba(255,255,255,0.25);
      }
      .tab:not([aria-selected="true"]) .tab-count {
        background: rgba(0,0,0,0.08);
        color: rgba(0,0,0,0.55);
      }
      @media print {
        .no-print { display: none !important; }
        .add-postit { display: none !important; }
        .postit { box-shadow: none; border: 1px solid #ccc; transform: none !important; }
        .postit::after { display: none; }
        body { background: white; }
        .board { background: white; border: 1px solid #ddd; }
        .print-block { display: block !important; break-inside: avoid; page-break-before: always; }
        .print-block:first-child { page-break-before: auto; }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Top toolbar -->
    <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-black/8 no-print">
      <div class="max-w-[1280px] mx-auto px-4 md:px-8 flex items-center justify-between gap-3 h-14">
        <div class="flex items-center gap-3">
          <img src="/agensea-logo.png" alt="Agensea" width="20" height="20" class="rounded" />
          <span class="font-semibold text-[15px] text-[#0d0d0d] tracking-tight" style="font-family:'Outfit',sans-serif">Agensea</span>
          <span class="text-black/30 text-sm">×</span>
          <span class="font-display text-lg text-[#5E1F5C]">Klarijn</span>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" data-action="reset"
            class="text-xs font-medium text-black/55 hover:text-black hover:bg-[var(--ag-indigo-sky)] px-3 py-1.5 rounded-full transition-colors">
            Reset
          </button>
          <button type="button" data-action="share"
            class="text-xs font-medium text-black hover:bg-[var(--ag-indigo-sky)] hover:text-[var(--ag-indigo)] px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            Link delen
          </button>
          <button type="button" data-action="print"
            class="text-xs font-semibold text-white px-4 py-1.5 rounded-full transition-colors"
            style="background: var(--ag-indigo)">
            PDF
          </button>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="max-w-[1280px] mx-auto px-4 md:px-8 pt-10 md:pt-14 pb-6">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="text-[.65rem] font-bold uppercase tracking-[.2em] text-[var(--ag-indigo)]" style="font-family:'Outfit',sans-serif">
          Werksessie · 90 minuten
        </span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl text-[#5E1F5C] leading-[.95] mb-3">
        Strategiesessie<br/>
        <span style="color: #E0277A">website Klarijn</span>
      </h1>
      <p class="text-base text-black/65 max-w-[60ch] leading-relaxed">
        Twee onderdelen, twee borden. Plak per onderwerp uw inzichten op een post-it. Eén regel per post-it volstaat. De link is deelbaar, dus de sessie kan ook na afloop worden aangevuld.
      </p>
    </section>

    <!-- Tabs -->
    <nav class="max-w-[1280px] mx-auto px-4 md:px-8 mb-5 no-print">
      <div class="flex flex-wrap gap-2 items-center" role="tablist" id="tabs"></div>
    </nav>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#0d0d0d] text-white text-sm px-4 py-2 rounded-full shadow-2xl pointer-events-none opacity-0 transition-opacity duration-300 z-50 no-print"></div>

    <!-- Boards -->
    <main class="max-w-[1280px] mx-auto px-4 md:px-8 pb-20">
      <div id="boards"></div>

      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 no-print">
        <p class="text-xs text-black/50 m-0">
          Auto-save in browser. Wijzigingen zitten ook in de URL, zodat de link gedeeld kan worden.
        </p>
        <div class="flex items-center gap-2">
          <img src="/agensea-logo.png" alt="Agensea" width="18" height="18" class="rounded" />
          <span class="text-xs font-semibold" style="font-family:'Outfit',sans-serif">Agensea</span>
          <span class="text-black/30 text-xs">×</span>
          <span class="font-display text-xs text-[#5E1F5C]">Klarijn</span>
        </div>
      </div>
    </main>

    <!-- Share modal -->
    <div id="share-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center p-4 no-print" style="display:none">
      <div class="bg-white rounded-2xl p-7 md:p-9 max-w-md w-full shadow-2xl">
        <h3 class="font-display text-2xl text-[#5E1F5C] mb-2">Sessie delen</h3>
        <p class="text-sm text-black/65 mb-4 leading-relaxed">
          Deze link bevat alle huidige post-its. Stuur naar de klant of een collega, zij zien bij openen exact wat hier staat en kunnen zelf bijplakken.
        </p>
        <div class="flex gap-2 mb-4">
          <input id="share-url" type="text" readonly
                 class="flex-1 bg-[#faf9f6] border border-black/10 rounded-lg px-3 py-2 text-xs font-mono text-black/70 focus:outline-none" />
          <button id="share-copy" type="button"
                  class="text-xs font-semibold text-white px-4 py-2 rounded-lg transition-colors"
                  style="background: var(--ag-indigo)">
            Kopieer
          </button>
        </div>
        <p class="text-xs text-black/50 mb-4 leading-relaxed">
          Wijzigingen aan hun kant zijn pas zichtbaar wanneer zij hun bijgewerkte link terugsturen.
        </p>
        <button type="button" data-close-modal class="text-sm font-medium text-black/55 hover:text-black w-full text-center pt-2 border-t border-black/10">
          Sluiten
        </button>
      </div>
    </div>

    <script type="application/json" id="seed" set:html={JSON.stringify(seed)}></script>

    <script>
      const seedEl = document.getElementById('seed');
      const SEED = JSON.parse(seedEl.textContent);
      const clone = (o) => JSON.parse(JSON.stringify(o));

      const LS_KEY = 'klarijn_strategie_v4';
      let state;
      let activeTab = 0;

      function decodeFromHash() {
        const m = location.hash.match(/^#s=(.+)$/);
        if (!m) return null;
        try {
          const json = decodeURIComponent(escape(atob(decodeURIComponent(m[1]))));
          return JSON.parse(json);
        } catch { return null; }
      }
      function encodeToHash(s) {
        try {
          const json = JSON.stringify(s);
          const b64 = btoa(unescape(encodeURIComponent(json)));
          history.replaceState(null, '', '#s=' + encodeURIComponent(b64));
        } catch {}
      }

      const fromHash = decodeFromHash();
      if (fromHash && fromHash.boards) {
        state = fromHash;
      } else {
        try {
          const stored = localStorage.getItem(LS_KEY);
          state = stored ? JSON.parse(stored) : clone(SEED);
        } catch {
          state = clone(SEED);
        }
      }
      if (!state.boards) state.boards = clone(SEED.boards);

      let saveTimer = null;
      function save() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch {}
          encodeToHash(state);
        }, 200);
      }

      const tabsEl = document.getElementById('tabs');
      const boardsEl = document.getElementById('boards');

      function rndRotation() {
        return (Math.random() * 6 - 3).toFixed(2);
      }

      function makePostit(board, idx) {
        const note = board.notes[idx];
        const el = document.createElement('div');
        el.className = `postit pi-${note.c ?? 0}`;
        el.style.setProperty('--rot', (note.rot ?? rndRotation()) + 'deg');
        el.style.transform = `rotate(var(--rot))`;
        el.innerHTML = `
          <button class="x" type="button" title="Verwijder" tabindex="-1">×</button>
          <div class="postit-text" contenteditable="true" data-placeholder="schrijf...">${escapeHtml(note.text || '')}</div>
        `;
        const text = el.querySelector('.postit-text');
        text.addEventListener('input', () => { note.text = text.textContent; save(); });
        text.addEventListener('blur', () => {
          if (!note.text || !note.text.trim()) {
            const i = board.notes.indexOf(note);
            if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
          }
        });
        el.querySelector('.x').addEventListener('click', (e) => {
          e.stopPropagation();
          const i = board.notes.indexOf(note);
          if (i >= 0) { board.notes.splice(i, 1); save(); renderAll(); }
        });
        return el;
      }

      function makeAddBtn(board) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'add-postit';
        btn.innerHTML = `<span>+ post-it</span>`;
        btn.addEventListener('click', () => {
          const c = Math.floor(Math.random() * 5);
          board.notes.push({ text: '', c, rot: rndRotation() });
          save();
          renderAll();
          setTimeout(() => {
            const allNotes = document.querySelectorAll(`[data-board="${board.id}"] .postit-text`);
            const last = allNotes[allNotes.length - 1];
            last?.focus();
          }, 30);
        });
        return btn;
      }

      function makeBoard(board, isPrint = false) {
        const section = document.createElement('section');
        section.className = 'board rounded-2xl p-5 md:p-8 print-block';
        section.dataset.board = board.id;
        if (!isPrint) section.dataset.tabPanel = board.id;
        section.innerHTML = `
          <div class="mb-5">
            <div class="text-[.65rem] font-bold uppercase tracking-[.2em] text-[var(--ag-indigo)]" style="font-family:'Outfit',sans-serif">${escapeHtml(board.label)}</div>
            <h2 class="font-display text-2xl md:text-3xl text-[#5E1F5C] leading-tight mt-1">${escapeHtml(board.hint)}</h2>
          </div>
          <div class="flex flex-wrap gap-4 items-start postit-wall min-h-[200px]"></div>
        `;
        const wall = section.querySelector('.postit-wall');
        board.notes.forEach((_, idx) => {
          wall.appendChild(makePostit(board, idx));
        });
        wall.appendChild(makeAddBtn(board));
        return section;
      }

      function renderTabs() {
        tabsEl.innerHTML = '';
        state.boards.forEach((b, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.role = 'tab';
          btn.className = 'tab';
          btn.setAttribute('aria-selected', i === activeTab ? 'true' : 'false');
          btn.innerHTML = `${escapeHtml(b.label)}<span class="tab-count">${b.notes.length}</span>`;
          btn.addEventListener('click', () => {
            activeTab = i;
            renderAll();
          });
          tabsEl.appendChild(btn);
        });
      }

      function renderBoards() {
        boardsEl.innerHTML = '';
        // Show active board normally
        const active = state.boards[activeTab];
        if (active) {
          const section = makeBoard(active);
          boardsEl.appendChild(section);
        }
        // For print: also append all OTHER boards as print-only blocks
        state.boards.forEach((b, i) => {
          if (i === activeTab) return;
          const section = makeBoard(b, true);
          section.classList.add('hidden', 'print:block');
          section.style.marginTop = '24px';
          boardsEl.appendChild(section);
        });
      }

      function renderAll() {
        renderTabs();
        renderBoards();
      }

      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      }

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.style.opacity = '1';
        setTimeout(() => { t.style.opacity = '0'; }, 1800);
      }

      document.querySelector('[data-action="reset"]').addEventListener('click', () => {
        if (!confirm('Alle post-its weg en terug naar de pre-fill?')) return;
        state = clone(SEED);
        save();
        renderAll();
        showToast('Sessie gereset');
      });

      document.querySelector('[data-action="print"]').addEventListener('click', () => {
        window.print();
      });

      const shareModal = document.getElementById('share-modal');
      const shareUrl = document.getElementById('share-url');
      document.querySelector('[data-action="share"]').addEventListener('click', () => {
        encodeToHash(state);
        shareUrl.value = location.href;
        shareModal.style.display = 'flex';
      });
      document.querySelectorAll('[data-close-modal]').forEach(b => {
        b.addEventListener('click', () => { shareModal.style.display = 'none'; });
      });
      shareModal.addEventListener('click', (e) => {
        if (e.target === shareModal) shareModal.style.display = 'none';
      });
      document.getElementById('share-copy').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          showToast('Link gekopieerd');
          shareModal.style.display = 'none';
        } catch {
          shareUrl.select();
          document.execCommand('copy');
          showToast('Link gekopieerd');
        }
      });

      renderAll();
      encodeToHash(state);
    </script>
  </body>
</html>
