---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getPageAbonnement } from '../lib/content';

const page = await getPageAbonnement();

// Drie afrekenvormen. Strippenkaart staat bewust voorop (sessie: abonnement uit,
// bundels uren in). Bedragen zijn voorbeeldwaarden tot Klarijn ze aanlevert.
const vormen = [
  {
    tag: 'Vaste producten',
    t: 'Vaste prijs',
    d: 'Voor onze standaardproducten weet je de prijs vooraf, tot op de euro. Een arbeidscontract, algemene voorwaarden, een AVG-scan: één bedrag, geen nacalculatie.',
    foot: 'Prijs per product, vooraf bekend',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h6"/>',
    accent: true,
  },
  {
    tag: 'Populair',
    t: 'Strippenkaart',
    d: 'Koop een bundel uren, bijvoorbeeld 10, met rek erop. Houd je uren over? Die blijven van jou, bel ons gerust nog eens om iets door te nemen. Gebruik je minder dan gedacht, dan reken je minder af.',
    foot: 'Bundels van 5, 10 of 20 uur · voordeliger per uur',
    icon: '<rect x="2" y="6" width="20" height="12" rx="2"/><line x1="7" y1="6" x2="7" y2="18"/><line x1="12" y1="6" x2="12" y2="18"/><line x1="17" y1="6" x2="17" y2="18"/>',
    accent: false,
  },
  {
    tag: 'Maatwerk',
    t: 'Losse uren of regiebasis',
    d: 'Past je vraag niet in een product en wil je geen bundel? Dan reken je gewoon per uur of op regiebasis af. We spreken vooraf een richting en een verwachting af, zodat je niet voor verrassingen komt te staan.',
    foot: 'Per uur, in overleg',
    icon: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>',
    accent: false,
  },
];
---

<Layout title="Tarieven - Klarijn" active="Tarieven" description="Zo reken je af bij Klarijn: vaste prijzen voor producten, een strippenkaart in bundels van uren, of losse uren. Altijd op basis van afspraken.">
  <PageHero
    title={page.heroTitle}
    lead={page.heroLead}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Tarieven' }]}
  />

  <section class="section-y">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="max-w-[60ch] mb-10" data-reveal>
        <span class="eyebrow">Tarieven</span>
        <h2 class="display-2 mt-3">{page.perksIntro}</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        {vormen.map((v, i) => (
          <article
            class:list={[
              'rounded-card p-7 shadow-sm flex flex-col',
              v.accent ? 'bg-aubergine text-white' : 'bg-white',
            ]}
            data-reveal
            data-reveal-delay={i + 1}
          >
            <div class:list={['w-12 h-12 rounded-xl grid place-items-center mb-4', v.accent ? 'bg-white/12 text-magenta-soft' : 'text-magenta']} style={v.accent ? '' : 'background-color: rgba(224, 39, 122, 0.12);'}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={v.icon} />
            </div>
            <span class:list={['text-[.7rem] font-bold uppercase tracking-[.14em] mb-2', v.accent ? 'text-magenta-soft' : 'text-magenta']}>{v.tag}</span>
            <h3 class:list={['text-2xl font-semibold mb-3', v.accent ? 'text-white' : 'text-ink']}>{v.t}</h3>
            <p class:list={['text-sm leading-relaxed flex-1 mb-5', v.accent ? 'text-white/85' : 'text-ink-soft']}>{v.d}</p>
            <span class:list={['text-xs font-semibold pt-4 border-t', v.accent ? 'text-white/70 border-white/15' : 'text-ink-soft border-ink/10']}>{v.foot}</span>
          </article>
        ))}
      </div>

      <p class="text-xs text-ink-soft mt-4">Genoemde bedragen en bundels zijn voorbeelden voor deze demo, tot Klarijn de definitieve tarieven aanlevert.</p>
    </div>
  </section>

  <!-- ========== Nooit via de site ========== -->
  <section class="pb-4">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="bg-paper-2 rounded-card p-7 md:p-8 flex items-start gap-4 border-l-4 border-magenta" data-reveal>
        <svg class="shrink-0 text-magenta mt-0.5" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
        <div>
          <strong class="block text-lg font-semibold text-aubergine mb-1">Je rekent nooit af via de website.</strong>
          <p class="text-ink-soft m-0">We maken altijd eerst een afspraak en bespreken wat past. Pas daarna loopt de facturatie via Klarijn. Het mandje op deze site is dus een lijstje om het gesprek mee te starten, geen kassa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Klein abonnement (secundair) ========== -->
  <section class="section-y">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="grid sm:grid-cols-[1fr_auto] gap-6 items-center bg-white rounded-card p-7 md:p-9 shadow-sm" data-reveal>
        <div>
          <span class="eyebrow">Ook mogelijk</span>
          <h3 class="text-2xl font-semibold text-aubergine mt-2 mb-2">Liever één vast aanspreekpunt?</h3>
          <p class="text-ink-soft m-0 max-w-[60ch]">Voor wie Klarijn het hele jaar bij de hand wil hebben, als een huisarts, is er een eenvoudig abonnement: een vaste jurist die je kent, voor korte vragen tussendoor. We bespreken in een gesprek of dat bij je past.</p>
        </div>
        <a href="/contact" class="btn btn-purple whitespace-nowrap">Vraag ernaar <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-y bg-paper-2">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="grid sm:grid-cols-[240px_1fr] gap-8 lg:gap-10 items-center bg-white p-7 md:p-10 rounded-card shadow-sm">
        <div class="photo-blob aspect-square shrink-0 max-sm:w-40 max-sm:mx-auto">
          <img src="/img/stock/scene-laughing.jpg" alt="Marjon Verstegen, klant van Klarijn" loading="lazy" class="w-full h-full object-cover" />
        </div>
        <div>
          <blockquote class="m-0 text-xl md:text-2xl font-semibold leading-snug text-ink relative pl-10 max-sm:text-center max-sm:pl-0">
            <span class="absolute left-0 -top-2 font-display text-7xl text-magenta leading-none max-sm:hidden">"</span>
            Vroeger zocht ik op Google en hoopte op het beste. Nu app ik m'n jurist en heb ik binnen het uur antwoord. Ik heb afgelopen jaar twee keer een fout voorkomen die me tonnen had gekost.
          </blockquote>
          <cite class="block not-italic text-sm text-ink-soft mt-5 pl-10 max-sm:pl-0 max-sm:text-center">
            <strong class="block text-ink font-bold">Marjon Verstegen</strong>
            Directeur Verstegen Verpakkingen · Roermond
          </cite>
        </div>
      </div>
    </div>
  </section>
</Layout>
