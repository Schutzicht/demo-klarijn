---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Contact — Klarijn" active="Contact" description="Bel, mail of vraag het Klarijn. Reactie binnen 1 werkdag.">
  <PageHero
    title="Vraag het Klarijn."
    lead="Bel, mail of stel je vraag via dit formulier. We reageren binnen 1 werkdag — meestal sneller. Geen verplichtingen."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  />

  <section class="section-y">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-semibold text-ink mb-6">Drie manieren om in contact te komen</h2>

          <a href="tel:0651180138" class="block bg-white rounded-card p-6 mb-3 flex items-start gap-4 hover:shadow-lg transition-all no-underline">
            <div class="w-12 h-12 rounded-xl bg-magenta grid place-items-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-1">Bel ons direct</h3>
              <p class="text-ink-soft text-sm mb-2">Maandag t/m vrijdag 08.30 – 17.30 uur. Geen telefoonbomen, gewoon een mens.</p>
              <span class="text-xl font-semibold text-magenta">06 – 51 18 01 38</span>
            </div>
          </a>

          <a href="mailto:vraaghet@klarijn.nl" class="block bg-white rounded-card p-6 mb-3 flex items-start gap-4 hover:shadow-lg transition-all no-underline">
            <div class="w-12 h-12 rounded-xl bg-magenta grid place-items-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ink mb-1">Stuur een mail</h3>
              <p class="text-ink-soft text-sm mb-2">Je krijgt vandaag of morgenvroeg een reactie van een vaste jurist.</p>
              <span class="text-xl font-semibold text-magenta">vraaghet@klarijn.nl</span>
            </div>
          </a>

          <div class="bg-aubergine text-white rounded-card p-6 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-magenta grid place-items-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white mb-1">Of: vul het formulier in</h3>
              <p class="text-white/80 text-sm m-0">Geef ons even wat context, dan komen we voorbereid terug.</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-card p-7 md:p-8 shadow-lg">
          <h3 class="text-aubergine font-semibold text-2xl mt-0 mb-5">Stuur ons je vraag</h3>
          <form class="grid gap-4" id="contact-form" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="form-label">Voornaam<input class="form-input" required name="voornaam" /></label>
              <label class="form-label">Achternaam<input class="form-input" required name="achternaam" /></label>
            </div>
            <label class="form-label">Bedrijfsnaam<input class="form-input" name="bedrijf" /></label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="form-label">E-mail<input class="form-input" required type="email" name="email" /></label>
              <label class="form-label">Telefoon<input class="form-input" type="tel" name="telefoon" /></label>
            </div>
            <label class="form-label">Onderwerp
              <select class="form-input" name="onderwerp">
                <option>Algemene vraag</option>
                <option>Arbeidsrecht</option>
                <option>Contract / algemene voorwaarden</option>
                <option>Bedrijfsoverdracht / opvolging</option>
                <option>Geschil / incasso</option>
                <option>Privacy / AVG</option>
                <option>Vastgoed / huurcontract</option>
                <option>Abonnement</option>
                <option>Iets anders</option>
              </select>
            </label>
            <label class="form-label">Je vraag<textarea class="form-input min-h-32 resize-y" required name="vraag" placeholder="Vertel kort wat de aanleiding is."></textarea></label>
            <label class="flex items-start gap-2.5 text-sm font-normal text-ink normal-case tracking-normal">
              <input required type="checkbox" name="akkoord" class="w-4 h-4 mt-0.5 accent-magenta" />
              <span>Ik ga akkoord met het verwerken van mijn gegevens conform de privacyverklaring.</span>
            </label>
            <button type="submit" class="btn btn-primary w-full justify-center">Verstuur <span class="arrow">→</span></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => bindForm());
    if (document.readyState !== 'loading') bindForm();
    function bindForm() {
      const f = document.getElementById('contact-form') as HTMLFormElement | null;
      if (!f || (f as any).dataset.bound) return;
      (f as any).dataset.bound = '1';
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        f.outerHTML = `
          <div class="bg-white rounded-card p-10 text-center shadow-lg">
            <div class="w-16 h-16 mx-auto mb-4 bg-magenta rounded-full grid place-items-center text-white text-3xl">✓</div>
            <h3 class="text-2xl font-semibold text-aubergine mb-2">We hebben je bericht ontvangen</h3>
            <p class="text-ink-soft m-0">We bellen of mailen je binnen 1 werkdag terug.</p>
          </div>`;
      });
    }
  </script>
</Layout>
