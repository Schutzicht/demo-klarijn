---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="Word franchisenemer - Klarijn Franchise"
  description="Plan een eerste kennismakingsgesprek voor de Klarijn-franchise."
  variant="franchise"
  active="Contact"
>
  <PageHero
    title="Plan een<br/>kennismaking."
    lead="Geen verkoopgesprek, geen pitch. Een eerlijk gesprek waarin we vooral veel vragen stellen - en jij ook."
    crumbs={[{ label: 'Franchise', href: '/franchise' }, { label: 'Contact' }]}
  />

  <section class="section-y">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-12 items-start">
        <div>
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-gold mb-3 before:content-[''] before:w-6 before:h-0.5 before:bg-gold">Direct in contact</span>
          <h2 class="display-2 mt-3 mb-3">Liever bellen?</h2>
          <p class="text-lg text-ink-soft mb-6">We zitten er meestal binnen 5 minuten doorheen. Wij doen wat we beloven.</p>

          <div class="bg-aubergine text-white rounded-card p-7 mb-4 shadow-lg">
            <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-gold mb-2 before:content-[''] before:w-6 before:h-0.5 before:bg-gold">Direct contact</span>
            <p class="font-display text-3xl text-white my-1 leading-tight">Eibert Westerveld</p>
            <p class="text-white/80 mb-4 text-sm">Mede-oprichter Klarijn · franchise-portefeuille</p>
            <p class="m-0 mb-1"><a href="tel:0612345678" class="text-gold font-semibold hover:text-white">06 12 345 678</a></p>
            <p class="m-0"><a href="mailto:franchise@klarijn.nl" class="text-gold font-semibold hover:text-white">franchise@klarijn.nl</a></p>
          </div>

          <div class="bg-paper-2 rounded-card p-6 border-l-4 border-gold">
            <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-gold mb-2 before:content-[''] before:w-6 before:h-0.5 before:bg-gold">Belangrijk</span>
            <p class="m-0 text-ink">Heb je nog niet gedaan? Doe eerst de <a href="/franchise/beslisboom" class="text-magenta hover:text-magenta-deep font-semibold">match-test</a>. Scheelt iedereen tijd.</p>
          </div>
        </div>

        <div class="bg-white rounded-card p-7 md:p-8 shadow-lg">
          <h3 class="text-aubergine font-semibold text-2xl mt-0 mb-5">Plan een kennismaking</h3>
          <form class="grid gap-4" id="franchise-contact-form" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="form-label">Voornaam<input class="form-input" required name="voornaam" /></label>
              <label class="form-label">Achternaam<input class="form-input" required name="achternaam" /></label>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label class="form-label">E-mail<input class="form-input" required type="email" name="email" /></label>
              <label class="form-label">Telefoon<input class="form-input" type="tel" name="telefoon" /></label>
            </div>
            <label class="form-label">Huidige functie / werkgever<input class="form-input" name="functie" placeholder="Bijv. arbeidsrechtjurist bij..." /></label>
            <label class="form-label">Voorkeursrayon<input class="form-input" name="rayon" placeholder="Bijv. Twente, Zuid-Limburg, regio Eindhoven" /></label>
            <label class="form-label">Hoeveel jaar werkervaring?
              <select class="form-input" name="ervaring">
                <option>3 – 5 jaar</option>
                <option>5 – 10 jaar</option>
                <option>10 – 15 jaar</option>
                <option>15+ jaar</option>
              </select>
            </label>
            <label class="form-label">Specifieke vraag of opmerking<textarea class="form-input min-h-32 resize-y" name="vraag"></textarea></label>
            <label class="flex items-start gap-2.5 text-sm font-normal text-ink normal-case tracking-normal">
              <input required type="checkbox" name="akkoord" class="w-4 h-4 mt-0.5 accent-magenta" />
              <span>Ik ga akkoord met het verwerken van mijn gegevens. Bewaartermijn: 12 maanden.</span>
            </label>
            <button type="submit" class="btn btn-primary w-full justify-center">Plan kennismaking <span class="arrow">→</span></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => bind());
    if (document.readyState !== 'loading') bind();
    function bind() {
      const f = document.getElementById('franchise-contact-form') as HTMLFormElement | null;
      if (!f || (f as any).dataset.bound) return;
      (f as any).dataset.bound = '1';
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        f.outerHTML = `
          <div class="bg-white rounded-card p-10 text-center shadow-lg">
            <div class="w-16 h-16 mx-auto mb-4 bg-magenta rounded-full grid place-items-center text-white text-3xl">✓</div>
            <h3 class="text-2xl font-semibold text-aubergine mb-2">Bedankt - we nemen binnen 2 werkdagen contact op.</h3>
          </div>`;
      });
    }
  </script>
</Layout>
