---
// "Waar gaat je vraag over?" - conversational Q&A in Klarijn-stijl.
// Past in een card op de rechterkolom van de hero. Subtiele Eibert in de header.
// Bij klikken op een onderwerp verschijnt het Klarijn-antwoord in Dirk-vraagt bubble-stijl.

import { klarijnAnswerer } from '../data/dirkVraagt';

const segments = [
  {
    id: 'personeel',
    label: 'Personeel & arbeidsrecht',
    answer:
      'Van arbeidscontract tot ontslag, of een dossier bij UWV. We pakken het op met een vaste prijs vooraf, geen verrassingen.',
    actions: [
      { title: 'Arbeidscontract op maat', desc: 'Vaste prijs, 5 dagen.', href: '/product' },
      { title: 'Stel je vraag direct', desc: 'Antwoord binnen 1 werkdag.', kind: 'ask' as const, prefill: 'Ik heb een vraag over personeel of arbeidsrecht' },
    ],
  },
  {
    id: 'incasso',
    label: 'Onbetaalde facturen',
    answer:
      'No-cure-no-pay incasso. Aanmaning, sommatie, en zo nodig kort geding. In 9 van 10 zaken al opgelost na de eerste brief.',
    actions: [
      { title: 'Incasso pakket', desc: 'No-cure-no-pay basis.', href: '/oplossingen' },
      { title: 'Direct advies', desc: 'Schets je situatie.', kind: 'ask' as const, prefill: 'Mijn klant betaalt al langere tijd niet, kunnen jullie helpen?' },
    ],
  },
  {
    id: 'contracten',
    label: 'Contracten & voorwaarden',
    answer:
      'Algemene voorwaarden of een contract op maat. Branchespecifiek, juridisch waterdicht, in plain Nederlands. Geen template.',
    actions: [
      { title: 'Algemene Voorwaarden', desc: 'Vaste prijs.', href: '/oplossingen' },
      { title: 'Laat dit checken', desc: 'Reactie binnen 1 werkdag.', kind: 'ask' as const, prefill: 'Ik wil een contract laten beoordelen' },
    ],
  },
  {
    id: 'overdracht',
    label: 'Bedrijfsovername',
    answer:
      'Drie sporen tegelijk: structuur, fiscaal, en de menselijke kant. Tijdslijn van 18 maanden zodat je niets vergeet.',
    actions: [
      { title: 'Familieoverdracht', desc: 'Volledig 18-maanden traject.', href: '/oplossingen' },
      { title: 'Eerst even sparren', desc: 'Geen verkooppraat.', kind: 'ask' as const, prefill: 'We willen de zaak overdragen, waar moeten we beginnen?' },
    ],
  },
  {
    id: 'anders',
    label: 'Iets anders',
    answer:
      'Veel vragen passen niet binnen vaste hokjes. Stuur jouw situatie en je krijgt binnen 1 werkdag een eerste duiding.',
    actions: [
      { title: 'Stel je vraag', desc: 'Geen formulier-bureaucratie.', kind: 'ask' as const, prefill: '' },
      { title: 'Bel ons direct', desc: 'Ma-Vr 08.30 - 17.30.', href: 'tel:0651180138' },
    ],
  },
];

const klarijnImg = klarijnAnswerer.img;
---

<div class="hero-ask bg-white rounded-jumbo p-6 md:p-7 shadow-[0_20px_50px_-12px_rgba(94,31,92,0.18)] relative" data-hero-ask>
  <!-- Header: subtiele Eibert avatar + vraag -->
  <div class="flex items-start gap-4 mb-5">
    <span class="relative shrink-0">
      <span class="block w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border-[2.5px] border-white shadow-md">
        <img
          src={klarijnImg}
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover object-top scale-[1.6] origin-top"
        />
      </span>
      <!-- Mini-bubble accent rechtsboven, subtiele referentie naar de FAB -->
      <img
        src="/img/vraag-het-bubble.webp"
        alt=""
        aria-hidden="true"
        class="absolute -top-3 -right-3 w-7 md:w-8 h-auto opacity-95"
      />
    </span>
    <div class="pt-1">
      <span class="block text-[.7rem] font-bold uppercase tracking-[.14em] text-magenta mb-1">Vraag het Klarijn</span>
      <p class="font-display text-xl md:text-2xl text-aubergine m-0 leading-tight">Waar gaat je vraag over?</p>
    </div>
  </div>

  <!-- Topic chips -->
  <div class="flex flex-wrap gap-2 mb-5">
    {segments.map((seg) => (
      <button
        type="button"
        class="ask-chip group bg-paper border-[1.5px] border-ink/10 rounded-full px-3.5 py-2 text-sm font-medium text-aubergine hover:border-magenta hover:bg-magenta hover:text-white hover:-translate-y-0.5 transition-all cursor-pointer data-[active]:bg-magenta data-[active]:border-magenta data-[active]:text-white"
        data-ask-id={seg.id}
      >{seg.label}</button>
    ))}
  </div>

  <!-- Antwoord-bubble: verschijnt bij selecteren -->
  <div data-ask-result>
    <!-- Empty state -->
    <p class="text-ink-soft text-xs text-center pt-2 border-t border-ink/8" data-ask-empty>
      Klik een onderwerp aan om Klarijn's eerste duiding te zien
    </p>

    {segments.map((seg) => (
      <div class="ask-content hidden border-t border-ink/8 pt-5" data-ask-content={seg.id}>
        <!-- Klarijn antwoord-bubble in Dirk-vraagt-stijl -->
        <div class="flex items-start gap-3">
          <span class="relative w-9 h-9 rounded-full overflow-hidden border-[2px] border-white shrink-0 shadow-sm ring-2 ring-magenta/25">
            <img src={klarijnImg} alt="" aria-hidden="true" class="w-full h-full object-cover object-top scale-[1.6] origin-top" />
          </span>
          <div class="flex-1 min-w-0">
            <div class="bg-paper-2 px-4 py-3 rounded-tl-md rounded-tr-2xl rounded-br-2xl rounded-bl-2xl">
              <div class="text-[.65rem] font-bold uppercase tracking-wider text-magenta mb-1">Klarijn antwoordt</div>
              <p class="text-sm md:text-[.95rem] text-ink leading-relaxed m-0">{seg.answer}</p>
            </div>
          </div>
        </div>

        <!-- Vervolg-acties -->
        <div class="grid sm:grid-cols-2 gap-2 mt-3 ml-12">
          {seg.actions.map((act) => (
            act.href ? (
              <a
                href={act.href}
                class="group flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl bg-paper border border-ink/8 hover:bg-white hover:border-magenta hover:shadow-md transition-all"
              >
                <div class="min-w-0">
                  <h4 class="font-sans font-bold text-aubergine text-xs m-0 truncate">{act.title}</h4>
                  <p class="text-[.7rem] text-ink-soft mt-0.5 m-0 truncate">{act.desc}</p>
                </div>
                <span class="w-6 h-6 rounded-full bg-white shrink-0 flex items-center justify-center border border-ink/10 group-hover:bg-magenta group-hover:border-magenta group-hover:text-white transition-colors text-ink-soft">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            ) : (
              <button
                type="button"
                data-ask-prefill={act.prefill || ''}
                class="group w-full text-left flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl bg-magenta text-white border border-magenta hover:bg-magenta-deep hover:shadow-md transition-all"
              >
                <div class="min-w-0">
                  <h4 class="font-sans font-bold text-white text-xs m-0 truncate">{act.title}</h4>
                  <p class="text-[.7rem] text-white/85 mt-0.5 m-0 truncate">{act.desc}</p>
                </div>
                <span class="w-6 h-6 rounded-full bg-white shrink-0 flex items-center justify-center text-magenta">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </button>
            )
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ask-content {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1), transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ask-content.is-active {
    display: block;
    opacity: 1;
    transform: none;
  }
  .ask-content.is-leaving {
    opacity: 0;
    transform: translateY(-8px);
  }
</style>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-hero-ask]');
    if (!root || (root as any).dataset.bound) return;
    (root as any).dataset.bound = '1';

    const chips = root.querySelectorAll<HTMLButtonElement>('[data-ask-id]');
    const empty = root.querySelector<HTMLElement>('[data-ask-empty]');
    const contents = root.querySelectorAll<HTMLElement>('[data-ask-content]');
    let activeId: string | null = null;

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.askId || '';
        if (id === activeId) return;

        // Hide empty state
        if (empty && !activeId) {
          empty.style.display = 'none';
        }

        // Toggle active state on chips
        chips.forEach((c) => {
          if (c.dataset.askId === id) c.setAttribute('data-active', '');
          else c.removeAttribute('data-active');
        });

        // Hide previous content
        contents.forEach((c) => {
          if (c.classList.contains('is-active')) {
            c.classList.add('is-leaving');
            setTimeout(() => {
              c.classList.remove('is-active', 'is-leaving');
              c.classList.add('hidden');
            }, 220);
          }
        });

        // Show new content
        const target = root.querySelector<HTMLElement>(`[data-ask-content="${id}"]`);
        if (target) {
          setTimeout(() => {
            target.classList.remove('hidden');
            requestAnimationFrame(() => {
              target.classList.add('is-active');
            });
          }, 220);
        }

        activeId = id;
      });
    });

    // "Ask"-buttons: open VraagHet modal met prefill
    root.querySelectorAll<HTMLButtonElement>('[data-ask-prefill]').forEach((b) => {
      b.addEventListener('click', () => {
        const q = b.dataset.askPrefill || '';
        document.dispatchEvent(new CustomEvent('vraaghet:open', { detail: { question: q } }));
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
