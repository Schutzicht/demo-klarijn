---
// "Waar gaat je vraag over?" - conversational Q&A in Klarijn-stijl.
// Geen kistje of dropdown: gewoon chips + animated Klarijn-antwoord-bubble eronder.
// Interaction-pattern uit homepagina-zeezicht, vorm uit Klarijn's eigen DirkVraagt-module.

import { klarijnAnswerer } from '../data/dirkVraagt';

const segments = [
  {
    id: 'personeel',
    label: 'personeel & arbeidsrecht',
    answer:
      'Van arbeidscontract tot ontslag, of een dossier bij UWV. We pakken het op met een vaste prijs vooraf, geen verrassingen.',
    actions: [
      { title: 'Arbeidscontract op maat', desc: 'Vaste prijs, 5 dagen, cao-conform.', href: '/product' },
      { title: 'Stel je vraag direct', desc: 'Antwoord binnen 1 werkdag.', kind: 'ask' as const, prefill: 'Ik heb een vraag over personeel of arbeidsrecht' },
    ],
  },
  {
    id: 'incasso',
    label: 'onbetaalde facturen',
    answer:
      'No-cure-no-pay incasso. Aanmaning, sommatie, en zo nodig kort geding. In 9 van 10 zaken al opgelost na de eerste brief.',
    actions: [
      { title: 'Incasso pakket', desc: 'No-cure-no-pay basis.', href: '/oplossingen' },
      { title: 'Direct advies', desc: 'Schets je situatie, wij reageren.', kind: 'ask' as const, prefill: 'Mijn klant betaalt al langere tijd niet, kunnen jullie helpen?' },
    ],
  },
  {
    id: 'contracten',
    label: 'contracten & voorwaarden',
    answer:
      'Algemene voorwaarden of een contract op maat - branchespecifiek, juridisch waterdicht, in plain Nederlands. Geen template.',
    actions: [
      { title: 'Algemene Voorwaarden', desc: 'Vaste prijs, incl. update-recht.', href: '/oplossingen' },
      { title: 'Laat dit contract checken', desc: 'Reactie binnen 1 werkdag.', kind: 'ask' as const, prefill: 'Ik wil een contract laten beoordelen' },
    ],
  },
  {
    id: 'overdracht',
    label: 'bedrijfsovername of opvolging',
    answer:
      'Drie sporen tegelijk: structuur, fiscaal, en de menselijke kant. Tijdslijn van 18 maanden zodat je niets vergeet.',
    actions: [
      { title: 'Bedrijfsoverdracht Familie', desc: 'Volledig traject van 18 maanden.', href: '/oplossingen' },
      { title: 'Eerst even sparren', desc: 'Geen verkooppraat, gewoon goede vragen.', kind: 'ask' as const, prefill: 'We willen de zaak overdragen, waar moeten we beginnen?' },
    ],
  },
  {
    id: 'anders',
    label: 'iets anders',
    answer:
      'Veel vragen passen niet binnen vaste hokjes. Stuur jouw situatie en je krijgt binnen 1 werkdag een eerste duiding van een vaste jurist.',
    actions: [
      { title: 'Stel je vraag', desc: 'Geen formulier-bureaucratie.', kind: 'ask' as const, prefill: '' },
      { title: 'Bel ons direct', desc: 'Maandag t/m vrijdag, 08.30 - 17.30.', href: 'tel:0651180138' },
    ],
  },
];

const klarijnImg = klarijnAnswerer.img;
---

<div class="hero-ask" data-hero-ask>
  <!-- Vraag-prompt: avatar Eibert + "Waar gaat je vraag over?" -->
  <div class="flex items-center justify-center gap-4 mb-8 md:mb-10">
    <span class="relative w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border-[3px] border-white shadow-md shrink-0">
      <img src={klarijnImg} alt="" aria-hidden="true" class="w-full h-full object-cover scale-110" />
    </span>
    <p class="font-display text-2xl md:text-4xl text-aubergine m-0 leading-tight">Waar gaat je vraag over?</p>
  </div>

  <!-- Topic chips - gewoon zichtbaar, klikbaar, geen dropdown -->
  <div class="flex flex-wrap justify-center gap-2 md:gap-3 mb-8 md:mb-12">
    {segments.map((seg) => (
      <button
        type="button"
        class="ask-chip group bg-white border-[1.5px] border-ink/10 rounded-full px-5 py-3 text-sm md:text-base font-medium text-aubergine hover:border-magenta hover:bg-magenta hover:text-white hover:-translate-y-0.5 transition-all cursor-pointer shadow-sm hover:shadow-md data-[active]:bg-magenta data-[active]:border-magenta data-[active]:text-white data-[active]:shadow-md"
        data-ask-id={seg.id}
      >{seg.label}</button>
    ))}
  </div>

  <!-- Antwoord-bubble: verschijnt onder de chips, in Dirk-vraagt-stijl met avatar + bubble -->
  <div class="max-w-3xl mx-auto" data-ask-result>
    <!-- Initial empty state - subtiele uitnodiging -->
    <div class="text-center text-ink-soft text-sm font-medium opacity-70" data-ask-empty>
      ↑ Klik een onderwerp aan om Klarijn's eerste duiding te zien
    </div>

    {segments.map((seg) => (
      <div class="ask-content hidden" data-ask-content={seg.id}>
        <div class="flex items-start gap-4">
          <!-- Klarijn avatar -->
          <span class="relative w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md ring-2 ring-magenta/30">
            <img src={klarijnImg} alt="Klarijn antwoordt" class="w-full h-full object-cover scale-110" />
          </span>

          <div class="flex-1 min-w-0">
            <!-- Antwoord-bubble in Dirk-vraagt-stijl -->
            <div class="bg-white px-5 md:px-6 py-4 md:py-5 rounded-tl-md rounded-tr-2xl rounded-br-2xl rounded-bl-2xl shadow-sm">
              <div class="text-xs font-bold uppercase tracking-wider text-magenta mb-2">Klarijn antwoordt</div>
              <p class="text-base md:text-lg text-ink leading-relaxed m-0">{seg.answer}</p>
            </div>

            <!-- Vervolg-acties -->
            <div class="grid sm:grid-cols-2 gap-2.5 mt-3">
              {seg.actions.map((act) => (
                act.href ? (
                  <a
                    href={act.href}
                    class="group flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-paper-2 border border-ink/8 hover:bg-white hover:border-magenta hover:shadow-md transition-all"
                  >
                    <div class="min-w-0">
                      <h4 class="font-sans font-bold text-aubergine text-sm m-0 truncate">{act.title}</h4>
                      <p class="text-xs text-ink-soft mt-0.5 m-0 truncate">{act.desc}</p>
                    </div>
                    <span class="w-7 h-7 rounded-full bg-white shrink-0 flex items-center justify-center border border-ink/10 group-hover:bg-magenta group-hover:border-magenta group-hover:text-white transition-colors text-ink-soft">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </a>
                ) : (
                  <button
                    type="button"
                    data-ask-prefill={act.prefill || ''}
                    class="group w-full text-left flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-magenta text-white border border-magenta hover:bg-magenta-deep hover:shadow-md transition-all"
                  >
                    <div class="min-w-0">
                      <h4 class="font-sans font-bold text-white text-sm m-0 truncate">{act.title}</h4>
                      <p class="text-xs text-white/85 mt-0.5 m-0 truncate">{act.desc}</p>
                    </div>
                    <span class="w-7 h-7 rounded-full bg-white shrink-0 flex items-center justify-center text-magenta">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </button>
                )
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .ask-content {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ask-content.is-active {
    display: block;
    opacity: 1;
    transform: none;
  }
  .ask-content.is-leaving {
    opacity: 0;
    transform: translateY(-12px);
  }
</style>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-hero-ask]');
    if (!root || (root as any).dataset.bound) return;
    (root as any).dataset.bound = '1';

    const chips = root.querySelectorAll<HTMLButtonElement>('[data-ask-id]');
    const empty = root.querySelector<HTMLElement>('[data-ask-empty]');
    const contents = root.querySelectorAll<HTMLElement>('[data-ask-content]');
    let activeId: string | null = null;

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.askId || '';
        if (id === activeId) return;

        // Hide empty state
        if (empty && !activeId) {
          empty.style.opacity = '0';
          setTimeout(() => { empty.style.display = 'none'; }, 200);
        }

        // Toggle active state on chips
        chips.forEach((c) => {
          if (c.dataset.askId === id) c.setAttribute('data-active', '');
          else c.removeAttribute('data-active');
        });

        // Hide previous content
        contents.forEach((c) => {
          if (c.classList.contains('is-active')) {
            c.classList.add('is-leaving');
            setTimeout(() => {
              c.classList.remove('is-active', 'is-leaving');
              c.classList.add('hidden');
            }, 250);
          }
        });

        // Show new content
        const target = root.querySelector<HTMLElement>(`[data-ask-content="${id}"]`);
        if (target) {
          setTimeout(() => {
            target.classList.remove('hidden');
            requestAnimationFrame(() => {
              target.classList.add('is-active');
            });
          }, 250);
        }

        activeId = id;
      });
    });

    // "Ask"-buttons in actions: open VraagHet modal met prefill
    root.querySelectorAll<HTMLButtonElement>('[data-ask-prefill]').forEach((b) => {
      b.addEventListener('click', () => {
        const q = b.dataset.askPrefill || '';
        document.dispatchEvent(new CustomEvent('vraaghet:open', { detail: { question: q } }));
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:page-load', init);
</script>
