---
// Herbruikbaar quote-blok. Met foto = testimonial-kaart (homepage Dirk-Jan),
// zonder foto = rustig gecentreerd quote-blok (zelfde stijl, geen portret).
interface Props {
  quote: string;
  author?: string;
  role?: string;
  photo?: string;
  scenePhoto?: string;
  class?: string;
}
const { quote, author, role, photo, scenePhoto, class: cls = '' } = Astro.props;
---

{photo ? (
  <div class:list={['grid sm:grid-cols-[260px_1fr] gap-8 lg:gap-12 items-center bg-white p-7 md:p-12 rounded-jumbo shadow-sm', cls]}>
    <div class="relative">
      <div class="photo-blob aspect-square shrink-0 max-sm:w-44 max-sm:mx-auto">
        <img src={photo} alt={author ? `Portret ${author}` : ''} loading="lazy" class="w-full h-full object-cover" />
      </div>
      {scenePhoto && (
        <div class="hidden md:block absolute -bottom-4 -right-4 w-24 h-24 rounded-full overflow-hidden border-4 border-white shadow-lg">
          <img src={scenePhoto} alt="" aria-hidden="true" loading="lazy" class="w-full h-full object-cover" />
        </div>
      )}
    </div>
    <div>
      <blockquote class="m-0 text-2xl md:text-3xl font-semibold leading-snug text-ink relative pl-12 max-sm:text-center max-sm:pl-0">
        <span class="absolute left-0 -top-3 font-display text-8xl text-magenta leading-none max-sm:hidden">&ldquo;</span>
        <span set:html={quote} />
      </blockquote>
      {author && (
        <cite class="block not-italic text-sm text-ink-soft mt-6 pl-12 max-sm:pl-0 max-sm:text-center">
          <strong class="block text-ink font-bold text-base">{author}</strong>
          {role}
        </cite>
      )}
    </div>
  </div>
) : (
  <figure class:list={['bg-white p-7 md:p-12 rounded-jumbo shadow-sm', cls]}>
    <blockquote class="m-0 text-2xl md:text-3xl font-semibold leading-snug text-ink relative pl-12 max-sm:pl-0">
      <span class="absolute left-0 -top-3 font-display text-8xl text-magenta leading-none max-sm:hidden">&ldquo;</span>
      <span set:html={quote} />
    </blockquote>
    {author && (
      <cite class="block not-italic text-sm text-ink-soft mt-6 pl-12 max-sm:pl-0">
        <strong class="block text-ink font-bold text-base">{author}</strong>
        {role}
      </cite>
    )}
  </figure>
)}
