---
import { klantVragen, franchiseVragen, klarijnAnswerer, type DirkVraag } from '../data/dirkVraagt';

interface Props {
  variant?: 'klant' | 'franchise';
}
const { variant = 'klant' } = Astro.props;
const items: DirkVraag[] = variant === 'franchise' ? franchiseVragen : klantVragen;
const data = JSON.stringify(items);
const klarijnImg = klarijnAnswerer.img;
---

<article
  class="relative bg-white rounded-jumbo p-6 md:p-9 shadow-2xl overflow-hidden"
  data-dv-panel
  data-dv-data={data}
  data-dv-klarijn-img={klarijnImg}
>
  <span class="absolute top-0 right-0 w-1.5 h-full bg-magenta" aria-hidden="true"></span>

  <!-- Vraag-rij: asker rechts uitgelijnd (chat-stijl) -->
  <div class="flex items-start justify-end gap-3 md:gap-3.5 mb-5">
    <div class="flex-1 max-w-[85%] flex flex-col items-end min-w-0">
      <div class="text-xs font-semibold uppercase tracking-wider text-ink-soft mb-1.5 text-right" data-dv-name>-</div>
      <div class="bg-paper-2 px-5 py-4 rounded-tr-md rounded-tl-2xl rounded-bl-2xl rounded-br-2xl">
        <p class="font-sans font-semibold text-aubergine leading-snug text-base md:text-lg m-0 min-h-[2.5em]" data-dv-q></p>
      </div>
    </div>
    <span class="relative w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md">
      <img alt="" aria-hidden="true" class="w-full h-full object-cover" data-dv-asker-img />
    </span>
  </div>

  <!-- Antwoord-rij: Klarijn links uitgelijnd -->
  <div class="flex items-start gap-3 md:gap-3.5 mb-6">
    <span class="relative w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md ring-2 ring-magenta/30">
      <img src={klarijnImg} alt="Klarijn antwoordt" aria-hidden="true" class="w-full h-full object-cover object-top scale-[1.6] origin-top" />
    </span>
    <div class="flex-1 max-w-[85%] min-w-0">
      <div class="text-xs font-bold uppercase tracking-wider text-magenta mb-1.5">Klarijn antwoordt</div>
      <div class="bg-aubergine text-white px-5 py-4 rounded-tl-md rounded-tr-2xl rounded-br-2xl rounded-bl-2xl">
        <p class="leading-relaxed text-sm md:text-base m-0" data-dv-a></p>
      </div>
    </div>
  </div>

  <footer class="flex items-center justify-between gap-4">
    <div class="flex gap-1.5" data-dv-dots></div>
    <div class="flex gap-1.5">
      <button class="w-9 h-9 rounded-full bg-paper text-aubergine border-[1.5px] border-ink/10 cursor-pointer grid place-items-center text-xl hover:bg-magenta hover:text-white hover:border-magenta transition-all" data-dv-prev aria-label="Vorige">‹</button>
      <button class="w-9 h-9 rounded-full bg-paper text-aubergine border-[1.5px] border-ink/10 cursor-pointer grid place-items-center text-xl hover:bg-magenta hover:text-white hover:border-magenta transition-all" data-dv-next aria-label="Volgende">›</button>
    </div>
  </footer>
</article>

<script>
  type DV = { who: string; role: string; q: string; a: string; img: string };

  function init(panel: HTMLElement) {
    if (panel.dataset.bound) return;
    panel.dataset.bound = '1';

    const data: DV[] = JSON.parse(panel.dataset.dvData || '[]');
    if (data.length === 0) return;

    let idx = 0;

    const askerImg = panel.querySelector<HTMLImageElement>('[data-dv-asker-img]')!;
    const name = panel.querySelector<HTMLElement>('[data-dv-name]')!;
    const q = panel.querySelector<HTMLElement>('[data-dv-q]')!;
    const a = panel.querySelector<HTMLElement>('[data-dv-a]')!;
    const dots = panel.querySelector<HTMLElement>('[data-dv-dots]')!;
    const prev = panel.querySelector<HTMLButtonElement>('[data-dv-prev]')!;
    const next = panel.querySelector<HTMLButtonElement>('[data-dv-next]')!;

    let interval: ReturnType<typeof setInterval> | null = null;

    function render() {
      const d = data[idx];
      askerImg.src = d.img;
      askerImg.alt = `Foto van ${d.who}`;
      name.innerHTML = `<strong class="block text-ink font-semibold normal-case tracking-normal text-sm md:text-base">${d.who}</strong>${d.role}`;
      q.textContent = `"${d.q}"`;
      a.textContent = d.a;
      dots.innerHTML = '';
      data.forEach((_, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `Vraag ${i + 1}`);
        b.className =
          'h-2 rounded-full p-0 border-0 cursor-pointer transition-all ' +
          (i === idx ? 'bg-magenta w-6' : 'bg-paper-2 w-2');
        b.addEventListener('click', () => { idx = i; render(); reset(); });
        dots.appendChild(b);
      });
    }
    function go(delta: number) {
      idx = (idx + delta + data.length) % data.length;
      render();
    }
    function reset() {
      if (interval) clearInterval(interval);
      interval = setInterval(() => go(1), 7000);
    }
    prev.addEventListener('click', () => { go(-1); reset(); });
    next.addEventListener('click', () => { go(1); reset(); });
    panel.addEventListener('mouseenter', () => { if (interval) clearInterval(interval); });
    panel.addEventListener('mouseleave', reset);
    render();
    reset();
  }

  function bootAll() {
    document.querySelectorAll<HTMLElement>('[data-dv-panel]').forEach(init);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootAll);
  else bootAll();
  document.addEventListener('astro:page-load', bootAll);
</script>
