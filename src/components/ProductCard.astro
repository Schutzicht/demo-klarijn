---
import type { Product } from '../data/products';
import ProductIcon from './ProductIcon.astro';

interface Props {
  product: Product;
  href?: string;
}
const { product, href = '/product' } = Astro.props;
---

<article class="bg-white rounded-card overflow-hidden flex flex-col shadow-sm hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 relative">
  <div class="aspect-[5/3] bg-aubergine relative overflow-hidden">
    <span class="absolute top-3.5 left-3.5 bg-white text-aubergine px-3 py-1 text-[.72rem] font-bold uppercase tracking-wider rounded-full z-10">
      {product.tag}
    </span>
    <ProductIcon icon={product.icon} />
  </div>
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-xl font-semibold text-ink mb-2.5">
      <a href={href} class="text-ink no-underline hover:text-magenta transition-colors">
        {product.title}
      </a>
    </h3>
    <p class="text-ink-soft text-sm flex-1 mb-5 leading-relaxed">{product.description}</p>
    <div class="flex items-center justify-between gap-2 pt-4 border-t border-ink/10">
      <span class="text-xs text-ink-soft leading-tight">
        <strong class="block text-aubergine text-lg font-bold leading-none mb-0.5">{product.price}</strong>
        {product.priceLabel}
      </span>
      <button
        class="add-btn"
        data-slug={product.slug}
        data-title={product.title}
        data-tagline={product.tagline}
        data-stamp="Genoteerd!"
      >
        <span class="add-btn__label">In lijst</span>
      </button>
    </div>
  </div>
</article>
