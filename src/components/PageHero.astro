---
import Stamp from './Stamp.astro';

interface Crumb { label: string; href?: string; }
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  eyebrow?: string;
  stamps?: { text: string; rotate?: number; variant?: 'magenta' | 'gold' | 'purple' }[];
}
const { title, lead, crumbs = [], eyebrow, stamps = [] } = Astro.props;
---

<section class="bg-aubergine text-white relative overflow-hidden">
  <!-- Decorative speech bubble in corner -->
  <img src="/img/vraag-het-bubble.webp" alt="" aria-hidden="true" class="absolute right-8 top-8 w-20 md:w-24 h-auto opacity-25 hidden md:block rotate-12" />

  {stamps.length > 0 && stamps.map((s, i) => (
    <div class={`absolute z-20 hidden lg:block ${i === 0 ? 'top-12 right-[8%]' : i === 1 ? 'bottom-16 right-[20%]' : 'bottom-12 left-[40%]'}`}>
      <Stamp text={s.text} rotate={s.rotate ?? -8} variant={s.variant ?? 'magenta'} />
    </div>
  ))}

  <div class="max-w-[1240px] mx-auto px-4 md:px-8 py-14 md:py-24 relative z-10">
    {crumbs.length > 0 && (
      <nav class="text-xs font-medium text-white/70 mb-8 md:mb-10" aria-label="Kruimelpad">
        {crumbs.map((c, i) => (
          <Fragment>
            {c.href ? <a href={c.href} class="text-white/70 hover:text-white no-underline">{c.label}</a> : <span class="text-white">{c.label}</span>}
            {i < crumbs.length - 1 && <span class="mx-2 opacity-60">/</span>}
          </Fragment>
        ))}
      </nav>
    )}
    {eyebrow && (
      <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-magenta-soft mb-4 before:content-[''] before:w-6 before:h-0.5 before:bg-magenta-soft">{eyebrow}</span>
    )}
    <h1 class="text-white display-1 mb-5 text-balance" set:html={title} data-reveal />
    {lead && <p class="text-white/85 text-lg md:text-xl max-w-[56ch] leading-relaxed" data-reveal data-reveal-delay="1">{lead}</p>}
  </div>
</section>
