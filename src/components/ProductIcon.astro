---
import type { Product } from '../data/products';
interface Props { icon: Product['icon']; }
const { icon } = Astro.props;
---

<svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" class="w-full h-full block">
  <rect width="400" height="240" fill="#5E1F5C"/>
  <circle cx="320" cy="60" r="170" fill="#E0277A" opacity=".22"/>

  {icon === 'contract' && (
    <g transform="translate(80,50)" stroke="#FAF6F2" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="0" y="20" width="180" height="120" rx="8" fill="#FAF6F2" stroke="#FAF6F2"/>
      <line x1="20" y1="50" x2="120" y2="50" stroke="#5E1F5C"/>
      <line x1="20" y1="75" x2="160" y2="75" stroke="#5E1F5C"/>
      <line x1="20" y1="100" x2="140" y2="100" stroke="#5E1F5C"/>
      <line x1="20" y1="120" x2="100" y2="120" stroke="#5E1F5C"/>
      <circle cx="180" cy="20" r="20" fill="#E0277A" stroke="none"/>
      <path d="M170 20 l 7 7 l 13 -14" stroke="#FAF6F2" stroke-width="2.5"/>
    </g>
  )}

  {icon === 'gavel' && (
    <g transform="translate(140,40)" stroke="#FAF6F2" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M40 0 L40 130"/>
      <path d="M40 25 L 0 80 L 80 80 Z" fill="#E0277A" stroke="#E0277A"/>
      <path d="M40 25 L 80 25 L 120 80 L 40 80 Z"/>
      <path d="M40 130 L 80 130 M 40 155 L 80 155"/>
      <path d="M0 175 L 120 175" stroke-width="4"/>
    </g>
  )}

  {icon === 'briefcase' && (
    <g transform="translate(120,55)" stroke="#FAF6F2" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="0" y="50" width="50" height="80" fill="#FAF6F2" stroke="#FAF6F2"/>
      <rect x="65" y="20" width="50" height="110" fill="#FAF6F2" stroke="#FAF6F2"/>
      <rect x="130" y="65" width="50" height="65" fill="#FAF6F2" stroke="#FAF6F2"/>
      <line x1="-15" y1="130" x2="200" y2="130" stroke="#FAF6F2" stroke-width="4"/>
      <circle cx="155" cy="40" r="14" fill="#E0277A" stroke="none"/>
    </g>
  )}

  {icon === 'document' && (
    <g transform="translate(110,30)">
      <rect x="0" y="0" width="180" height="180" fill="#FAF6F2" rx="6"/>
      <line x1="20" y1="35" x2="160" y2="35" stroke="#5E1F5C" stroke-width="2.5"/>
      <line x1="20" y1="60" x2="140" y2="60" stroke="#5E1F5C" stroke-width="2"/>
      <line x1="20" y1="80" x2="160" y2="80" stroke="#5E1F5C" stroke-width="2"/>
      <line x1="20" y1="100" x2="120" y2="100" stroke="#5E1F5C" stroke-width="2"/>
      <line x1="20" y1="120" x2="160" y2="120" stroke="#5E1F5C" stroke-width="2"/>
      <circle cx="140" cy="155" r="20" fill="#E0277A"/>
      <path d="M130 155 l 7 7 l 13 -14" stroke="white" stroke-width="2.5" fill="none"/>
    </g>
  )}

  {icon === 'shield' && (
    <g transform="translate(160,30)">
      <path d="M60 0 L 0 25 L 0 95 C 0 140, 60 165, 60 165 C 60 165, 120 140, 120 95 L 120 25 Z" fill="#E0277A"/>
      <circle cx="60" cy="80" r="20" fill="#FAF6F2"/>
      <rect x="50" y="80" width="20" height="32" fill="#FAF6F2"/>
    </g>
  )}

  {icon === 'house' && (
    <g transform="translate(80,40)">
      <path d="M0 90 L 120 15 L 240 90 L 240 175 L 0 175 Z" fill="#FAF6F2" stroke="#FAF6F2" stroke-width="2.5"/>
      <rect x="80" y="105" width="80" height="70" fill="#E0277A"/>
      <rect x="40" y="115" width="30" height="35" fill="#5E1F5C"/>
      <rect x="170" y="115" width="30" height="35" fill="#5E1F5C"/>
    </g>
  )}

  {icon === 'star' && (
    <g transform="translate(140,40)">
      <path d="M60 0 L 78 50 L 130 50 L 88 80 L 105 130 L 60 100 L 15 130 L 32 80 L 0 50 L 42 50 Z" fill="#E0277A" stroke="#3D0F3B" stroke-width="2"/>
      <circle cx="60" cy="170" r="14" fill="#FAF6F2"/>
    </g>
  )}

  {icon === 'handshake' && (
    <g transform="translate(110,55)" stroke="#FAF6F2" stroke-width="2.5" fill="none">
      <circle cx="40" cy="40" r="30" fill="#E0277A" stroke="#E0277A"/>
      <circle cx="120" cy="40" r="30" fill="#FAF6F2" stroke="#FAF6F2"/>
      <line x1="60" y1="50" x2="100" y2="50" stroke="#FAF6F2"/>
      <path d="M40 90 L 40 140 M 120 90 L 120 140 M -10 140 L 170 140" stroke="#FAF6F2" stroke-linecap="round"/>
    </g>
  )}

  {icon === 'family' && (
    <g transform="translate(140,40)">
      <path d="M0 80 Q 0 0 60 0 Q 120 0 120 80 Q 120 160 60 160 Q 0 160 0 80 Z" fill="#E0277A"/>
      <line x1="60" y1="0" x2="60" y2="160" stroke="#3D0F3B" stroke-width="6" stroke-dasharray="6 6"/>
    </g>
  )}

  {icon === 'folder' && (
    <g transform="translate(110,40)">
      <rect x="0" y="40" width="180" height="140" fill="#FAF6F2" stroke="#FAF6F2" rx="6"/>
      <rect x="20" y="0" width="100" height="50" fill="#E0277A" rx="6"/>
      <line x1="40" y1="90" x2="140" y2="90" stroke="#5E1F5C" stroke-width="2.5"/>
      <line x1="40" y1="115" x2="140" y2="115" stroke="#5E1F5C" stroke-width="2"/>
      <line x1="40" y1="140" x2="120" y2="140" stroke="#5E1F5C" stroke-width="2"/>
    </g>
  )}
</svg>
