---
import { klarijnAnswerer } from '../data/dirkVraagt';

interface Pair {
  who: string;
  role: string;
  q: string;
  a: string;
  /** Foto van de vragensteller. Vul in als je een specifieke foto wilt; default is een stock-portret obv naam. */
  img?: string;
}
interface Props {
  title?: string;
  eyebrow?: string;
  pairs: Pair[];
}
const { title, eyebrow = 'Vraag het Klarijn', pairs } = Astro.props;

// Vaste mapping naam → numerieke pravatar ID (curated adult portretten).
// Voorkomt random kid-photos die seed-strings opleveren.
const NAME_TO_ID: Record<string, number> = {
  sander: 11, esther: 13, eline: 14, dirk: 11, joris: 33, sandra: 44,
  kees: 65, mariska: 49, rik: 8, femke: 16, tim: 53,
};
const askerImg = (p: Pair) => {
  if (p.img) return p.img;
  const id = NAME_TO_ID[p.who.toLowerCase()] ?? 26;
  return `https://i.pravatar.cc/240?img=${id}`;
};
---

<div class="bg-white rounded-card p-7 md:p-10 shadow-sm">
  <span class="eyebrow">{eyebrow}</span>
  {title && <h3 class="text-2xl md:text-3xl font-semibold text-aubergine mt-1 mb-6">{title}</h3>}

  {pairs.map((p) => (
    <Fragment>
      <div class="flex items-start gap-3.5 my-3">
        <span class="relative w-12 h-12 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md">
          <img src={askerImg(p)} alt={`Foto van ${p.who}`} loading="lazy" class="w-full h-full object-cover" />
        </span>
        <div class="bg-paper-2 px-5 py-4 rounded-tl-md rounded-tr-2xl rounded-br-2xl rounded-bl-2xl flex-1 min-w-0">
          <strong class="block text-xs font-bold uppercase tracking-wider text-ink-soft mb-1.5">{p.who} · {p.role}</strong>
          <p class="m-0 text-base leading-relaxed">{p.q}</p>
        </div>
      </div>
      <div class="flex items-start gap-3.5 my-3 mb-6">
        <span class="relative w-12 h-12 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md ring-2 ring-magenta/30">
          <img src={klarijnAnswerer.img} alt="Klarijn antwoordt" loading="lazy" class="w-full h-full object-cover scale-110" />
        </span>
        <div class="bg-aubergine text-white px-5 py-4 rounded-tr-md rounded-tl-2xl rounded-br-2xl rounded-bl-2xl flex-1 min-w-0">
          <strong class="block text-xs font-bold uppercase tracking-wider text-magenta-soft mb-1.5">Klarijn antwoordt</strong>
          <p class="m-0 text-base leading-relaxed">{p.a}</p>
        </div>
      </div>
    </Fragment>
  ))}
</div>
