---
import { klarijnAnswerer } from '../data/dirkVraagt';

interface Pair {
  who: string;
  role: string;
  q: string;
  a: string;
  /** Foto van de vragensteller. Vul in als je een specifieke foto wilt. */
  img?: string;
}
interface Props {
  title?: string;
  eyebrow?: string;
  pairs: Pair[];
}
const { title, eyebrow = 'Vraag het Klarijn', pairs } = Astro.props;

// Vaste mapping naam → lokaal stock-portret. Visueel geverifieerd, geen random.
const NAME_TO_PHOTO: Record<string, string> = {
  sander: '/img/stock/p14.jpg',  // man kale kop met baard - praktisch (metaal)
  esther: '/img/stock/p13.jpg',  // vrouw business 35 - manager familiebedrijf
  eline: '/img/stock/p11.jpg',   // vrouw casual ~30
  dirk: '/img/stock/p14.jpg',
  joris: '/img/stock/p6.jpg',    // man bril pak - mkb directeur
  sandra: '/img/stock/p16.jpg',  // vrouw vrolijk ~30
  kees: '/img/stock/p3.jpg',     // oudere man bril
  mariska: '/img/stock/p9.jpg',  // vrouw vrolijk ~25-30
  rik: '/img/stock/p15.jpg',
  femke: '/img/stock/p2.jpg',
  tim: '/img/stock/p7.jpg',
};
const askerImg = (p: Pair) => p.img || NAME_TO_PHOTO[p.who.toLowerCase()] || '/img/stock/p1.jpg';
---

<div class="bg-white rounded-card p-7 md:p-10 shadow-sm">
  <span class="eyebrow">{eyebrow}</span>
  {title && <h3 class="text-2xl md:text-3xl font-semibold text-aubergine mt-1 mb-6">{title}</h3>}

  {pairs.map((p) => (
    <Fragment>
      <!-- Vraag-rij: asker rechts uitgelijnd -->
      <div class="flex items-start justify-end gap-3 my-3">
        <div class="flex-1 max-w-[85%] flex flex-col items-end min-w-0">
          <strong class="block text-xs font-bold uppercase tracking-wider text-ink-soft mb-1.5 text-right">{p.who} · {p.role}</strong>
          <div class="bg-paper-2 px-5 py-4 rounded-tr-md rounded-tl-2xl rounded-bl-2xl rounded-br-2xl">
            <p class="m-0 text-base leading-relaxed">{p.q}</p>
          </div>
        </div>
        <span class="relative w-12 h-12 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md">
          <img src={askerImg(p)} alt={`Foto van ${p.who}`} loading="lazy" class="w-full h-full object-cover" />
        </span>
      </div>

      <!-- Antwoord-rij: Klarijn links uitgelijnd -->
      <div class="flex items-start gap-3 my-3 mb-6">
        <span class="relative w-12 h-12 rounded-full overflow-hidden border-[3px] border-white shrink-0 shadow-md ring-2 ring-magenta/30">
          <img src={klarijnAnswerer.img} alt="Klarijn antwoordt" loading="lazy" class="w-full h-full object-cover object-top scale-[1.6] origin-top" />
        </span>
        <div class="flex-1 max-w-[85%] min-w-0">
          <strong class="block text-xs font-bold uppercase tracking-wider text-magenta mb-1.5">Klarijn antwoordt</strong>
          <div class="bg-aubergine text-white px-5 py-4 rounded-tl-md rounded-tr-2xl rounded-br-2xl rounded-bl-2xl">
            <p class="m-0 text-base leading-relaxed">{p.a}</p>
          </div>
        </div>
      </div>
    </Fragment>
  ))}
</div>
