---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="De aanpak - Klarijn Franchise"
  description="Hoe werkt het Klarijn-franchisemodel? Van eerste kennismaking tot eigen rayon binnen 4 maanden."
  variant="franchise"
  active="De aanpak"
>
  <PageHero
    title="Van kennismaking<br/>tot eigen rayon.<br/>In 4 maanden."
    lead="We willen je niet 6 maanden aan het lijntje houden. Als het past, gaan we snel. Als het niet past, weet je dat ook snel."
    crumbs={[{ label: 'Franchise', href: '/franchise' }, { label: 'De aanpak' }]}
  />

  <section class="section-y">
    <div class="max-w-[1240px] mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { n: '01', t: 'Match-test', d: '10 vragen, 3 minuten. Eerlijk antwoord: past Klarijn bij wat jij zoekt - en jij bij wat wij zoeken?' },
          { n: '02', t: 'Kennismaking', d: 'Twee gesprekken: één met een oprichter, één met een huidige rayonhouder. We willen dat je echt weet wat je tekent.' },
          { n: '03', t: 'Businessplan', d: 'Samen maken we het businessplan voor jouw rayon. Met realistische omzetprognoses op basis van pilot-data.' },
          { n: '04', t: 'Lancering', d: '4 weken intensieve onboarding (juridisch, software, branding) en dan ben je live - met klanten in je agenda.' },
        ].map((s) => (
          <article class="bg-white rounded-card p-7 shadow-sm hover:-translate-y-1 hover:shadow-lg transition-all">
            <div class="font-display text-5xl text-magenta leading-none mb-3">{s.n}</div>
            <h3 class="text-xl font-semibold text-aubergine mb-2">{s.t}</h3>
            <p class="text-ink-soft text-sm leading-relaxed mb-0">{s.d}</p>
          </article>
        ))}
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mt-12">
        <div class="bg-white rounded-jumbo p-8 shadow-sm">
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-magenta-soft mb-3 before:content-[''] before:w-6 before:h-0.5 before:bg-magenta">Wat je krijgt</span>
          <h2 class="text-2xl md:text-3xl font-semibold text-aubergine mt-2 mb-5">Het Klarijn-pakket</h2>
          <ul class="list-none p-0 space-y-2.5">
            {[
              'Exclusief rayon (geografisch afgebakend)',
              'Klarijn-merk + website + CMS',
              'Centrale leadgeneratie + lokale campagnes',
              'Software-stack (CRM, dossier, factureren)',
              'Toegang tot het specialistennetwerk',
              'Maandelijkse intervisie met collega\'s',
              'Backoffice voor administratie & HR',
            ].map((item) => (
              <li class="flex items-start gap-3 pb-2.5 border-b border-ink/10 last:border-0">
                <span class="mt-1 w-5 h-5 rounded-full bg-magenta shrink-0 grid place-items-center">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-aubergine text-white rounded-jumbo p-8">
          <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-magenta-soft mb-3 before:content-[''] before:w-6 before:h-0.5 before:bg-magenta">Wat we van jou vragen</span>
          <h2 class="text-2xl md:text-3xl font-semibold text-white mt-2 mb-5">Jouw inbreng</h2>
          <ul class="list-none p-0 space-y-2.5">
            {[
              'Minimaal 3 jaar relevante juridische werkervaring',
              'Ondernemende mindset, geen 9-tot-5',
              'Eenmalige inleg (afhankelijk van rayon)',
              'Bereidheid tot samenwerken (geen einzelgänger)',
              'Affiniteit met mkb / familiebedrijven / maakindustrie',
              'Lange-termijn-commitment',
            ].map((item) => (
              <li class="flex items-start gap-3 pb-2.5 border-b border-white/15 last:border-0 text-white/90">
                <span class="text-magenta-soft mt-0.5">→</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/franchise/beslisboom" class="btn btn-primary">Doe eerst de match-test <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Layout>
