# Strapi CMS koppeling - optioneel
# Niet ingesteld? Astro gebruikt de lokale fallback-data uit src/data/*.
# Wel ingesteld? Astro fetcht bij `npm run build` van Strapi.
#
# Lokale dev: STRAPI_URL=http://localhost:1337
# Productie:  STRAPI_URL=https://cms.klarijn.nl  (jouw eigen Strapi deploy)
STRAPI_URL=

# Optioneel: API-token voor authenticated reads (default leeg = publieke endpoints).
# Maak in Strapi admin: Settings > API Tokens > Add new API Token, type=Read-only.
STRAPI_TOKEN=
