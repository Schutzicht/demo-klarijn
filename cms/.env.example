# =====================================================
# Strapi - lokaal development (.env)
# =====================================================
HOST=0.0.0.0
PORT=1337

# Astro dev server (voor live preview iframe in admin)
CLIENT_URL=http://localhost:4400

# Secrets - genereer eigen waardes met: openssl rand -base64 16
APP_KEYS="key1==,key2==,key3==,key4=="
API_TOKEN_SALT=changeme==
ADMIN_JWT_SECRET=changeme==
TRANSFER_TOKEN_SALT=changeme==
JWT_SECRET=changeme==
ENCRYPTION_KEY=changeme==

# Database - SQLite voor lokaal, Postgres voor productie
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# =====================================================
# PRODUCTIE (Railway) - hieronder is alleen referentie
# =====================================================
# NODE_ENV=production
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://...   <- Railway zet deze automatisch
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# CLIENT_URL=https://klarijn.nl   <- de live Astro frontend
