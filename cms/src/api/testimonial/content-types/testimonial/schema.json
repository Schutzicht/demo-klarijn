{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Klant-quotes",
    "description": "Quotes die op homepage, abonnement en kantoorpaginas verschijnen."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "quote": {
      "type": "text",
      "required": true,
      "description": "De uitspraak in eerste persoon. Geen aanhalingstekens nodig, die plaatst de site zelf."
    },
    "author": {
      "type": "string",
      "required": true,
      "description": "Naam van degene die het zei."
    },
    "role": {
      "type": "string",
      "description": "Functie + bedrijfsnaam. Voorbeeld: 'Eigenaar Bouwbedrijf Van der Velde'."
    },
    "location": {
      "type": "string",
      "description": "Plaats. Voorbeeld: 'Apeldoorn'."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "scenePhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Aanvinken om deze quote op de homepage te tonen."
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "description": "Volgorde in de lijst. Lager getal = eerder getoond."
    },
    "photoUrl": {
      "type": "string",
      "description": "Technisch: fallback voor portret-foto.",
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    },
    "scenePhotoUrl": {
      "type": "string",
      "description": "Technisch: fallback voor sfeer-foto.",
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    }
  }
}
