{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team",
    "description": "Klarijn-juristen, oprichters en support. Verschijnt op /over-ons en kantoorpaginas."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Volledige naam (voornaam + achternaam). Voorbeeld: 'Eibert Lijnbach'."
    },
    "role": {
      "type": "string",
      "description": "Functietitel + specialisme. Voorbeeld: 'Mede-oprichter · Arbeidsrecht'."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "photoUrl": {
      "type": "string",
      "description": "Fallback-pad als nog geen foto is geupload. Voorbeeld: '/img/eibert.webp'."
    },
    "bio": {
      "type": "text",
      "description": "Korte introductie. 1-2 zinnen."
    },
    "email": {
      "type": "email",
      "description": "Klikbaar op de site."
    },
    "location": {
      "type": "string",
      "description": "Welke vestiging. Voorbeeld: 'Zwolle', 'Rotterdam'."
    },
    "type": {
      "type": "enumeration",
      "enum": ["oprichter", "senior", "jurist", "support", "rayonhouder"],
      "default": "jurist",
      "description": "Rolcategorie."
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "description": "Lager getal = eerder in de lijst."
    }
  }
}
