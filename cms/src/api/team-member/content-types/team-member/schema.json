{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Team",
    "description": "Klarijn-juristen, oprichters en support. Verschijnt op Over ons en de kantoorpagina."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Volledige naam. Voorbeeld: 'Eibert Lijnbach'."
    },
    "role": {
      "type": "string",
      "description": "Functietitel + specialisme. Voorbeeld: 'Mede-oprichter · Arbeidsrecht'."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "text",
      "description": "Korte introductie. 1-2 zinnen."
    },
    "email": {
      "type": "email",
      "description": "Klikbaar op de site. Mag leeg."
    },
    "location": {
      "type": "string",
      "description": "Vestiging. Voorbeeld: 'Zwolle', 'Rotterdam'."
    },
    "type": {
      "type": "enumeration",
      "enum": ["oprichter", "senior", "jurist", "support", "rayonhouder"],
      "default": "jurist",
      "description": "Rolcategorie. Bepaalt waar de persoon op de site verschijnt."
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "description": "Volgorde in de lijst. Lager getal = bovenaan."
    },
    "photoUrl": {
      "type": "string",
      "description": "Technisch: fallback-pad naar foto in /img/. Wordt gebruikt als bovenstaande Foto leeg is. Laat staan als er een foto is geupload.",
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    }
  }
}
