{
  "kind": "collectionType",
  "collectionName": "dirk_vraagts",
  "info": {
    "singularName": "dirk-vraagt",
    "pluralName": "dirk-vraagts",
    "displayName": "Vraag-het-Klarijn",
    "description": "Vraag-en-antwoord paren voor de Vraag-het-Klarijn sectie op de site."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "who": {
      "type": "string",
      "required": true,
      "description": "Voornaam van degene die de vraag stelt. Voorbeeld: 'Dirk', 'Mariska'."
    },
    "role": {
      "type": "string",
      "description": "Beroep + plaats. Voorbeeld: 'Aannemer · Apeldoorn'."
    },
    "question": {
      "type": "text",
      "required": true,
      "description": "De vraag zoals de bezoeker hem ziet."
    },
    "answer": {
      "type": "text",
      "required": true,
      "description": "Klarijn's antwoord. Helder, geen jargon."
    },
    "variant": {
      "type": "enumeration",
      "enum": ["klant", "franchise"],
      "default": "klant",
      "required": true,
      "description": "Klant = voor de bezoeker van de website. Franchise = voor juristen die overwegen mee te doen."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "description": "Volgorde in de lijst. Lager getal = eerder."
    },
    "photoUrl": {
      "type": "string",
      "description": "Technisch: fallback voor de foto.",
      "pluginOptions": {
        "content-manager": { "visible": false }
      }
    }
  }
}
